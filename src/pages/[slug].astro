---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { getCollection, render } from "astro:content";
import { Image, getImage } from "astro:assets";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
};

const { post } = Astro.props;
const { Content } = await render(post);

const categoryLabels: Record<string, string> = {
  entlarven: "Entlarven & Mechanik",
  learning: "Bitcoin verstehen",
  denkfehler: "Der große Bitcoin-Denkfehler",
};

// OG image: use post-specific image (optimized to landscape-ish for social cards) or fall back
let ogImagePath: string | undefined;
if (post.data.image) {
  const optimized = await getImage({
    src: post.data.image,
    width: 1200,
    format: "jpg",
  });
  ogImagePath = optimized.src;
}

// JSON-LD Article schema for Google
const site = Astro.site ?? new URL("https://bitandbullshit.com");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  inLanguage: "de-DE",
  url: new URL(`/${post.id}`, site).toString(),
  mainEntityOfPage: new URL(`/${post.id}`, site).toString(),
  articleSection: categoryLabels[post.data.category],
  keywords: post.data.keyword,
  image: ogImagePath
    ? new URL(ogImagePath, site).toString()
    : new URL("/og-default.png", site).toString(),
  author: {
    "@type": "Organization",
    name: "Bit & Bullshit",
    url: site.toString(),
  },
  publisher: {
    "@type": "Organization",
    name: "Bit & Bullshit",
    url: site.toString(),
    logo: {
      "@type": "ImageObject",
      url: new URL("/apple-touch-icon.png", site).toString(),
    },
  },
};
---

<Layout
  title={`${post.data.title} — Bit & Bullshit`}
  description={post.data.description}
  ogImage={ogImagePath}
  ogType="article"
  jsonLd={jsonLd}
>
  <SiteHeader />

  <main class="mx-auto max-w-3xl px-5 py-16 md:py-24">
    <a href="/blog" class="text-xs uppercase tracking-widest text-paper/60 hover:text-orange">
      &larr; Alle Snippets
    </a>

    <article
      class="mt-8"
      data-pagefind-body
      data-pagefind-meta={`category:${categoryLabels[post.data.category]}`}
    >
      <p class="display text-xs tracking-[0.3em] text-orange" data-pagefind-ignore>
        // {categoryLabels[post.data.category]}
      </p>
      <h1 class="post-h1 display mt-4 text-3xl md:text-5xl">
        {post.data.title}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-paper/80">
        {post.data.description}
      </p>

      {
        post.data.draft && (
          <div class="mt-8 rounded-lg border border-orange/40 bg-orange/10 p-4 text-sm text-paper/80">
            <strong class="text-orange">Entwurf:</strong> Der Fließtext folgt in Kürze.
            Bis dahin: Video auf TikTok/Insta ansehen.
          </div>
        )
      }

      {
        post.data.image && (
          <figure class="post-hero-image mt-10">
            <Image
              src={post.data.image}
              alt={post.data.imageAlt ?? `Bit & Bullshit Maskottchen zum Snippet: ${post.data.title}`}
              widths={[360, 540, 720]}
              sizes="(min-width: 768px) 28rem, 88vw"
              class="block h-auto w-full object-cover"
              loading="eager"
            />
          </figure>
        )
      }

      <div class="post-body mt-10">
        <Content />
      </div>

      {
        post.data.aeraLink && (
          <div class="mt-12 rounded-2xl border border-white/10 bg-white/[0.03] p-6" data-pagefind-ignore>
            <p class="display text-xs tracking-[0.3em] text-orange">// TIEFER EINSTEIGEN</p>
            <p class="mt-3 text-base text-paper/90">
              Ausführliche Erklärung mit Beispielen und Quellen:
              {" "}
              <a href={post.data.aeraLink} rel="noopener" class="drip-underline text-paper hover:text-orange">
                auf bitcoinaera.de weiterlesen &rarr;
              </a>
            </p>
          </div>
        )
      }

      <div class="mt-16 border-t border-white/10 pt-10" data-pagefind-ignore>
        <p class="display text-2xl md:text-3xl">
          Gefällt&apos;s dir? <span class="text-orange">Folg uns.</span>
        </p>
        <p class="mt-3 text-sm text-paper/70">
          Neue Snippets zuerst auf TikTok und Instagram. @bitandbullshit auf beiden.
        </p>
        <div class="mt-6">
          <SocialLinks />
        </div>
      </div>

      <p class="mt-10 text-xs leading-relaxed text-paper/50" data-pagefind-ignore>
        Nur Meinung &amp; Unterhaltung. Keine Finanz-, Steuer- oder Rechtsberatung.
      </p>
    </article>
  </main>

  <SiteFooter />
</Layout>

<style is:global>
  /* Artikel-Headline: Das deutsche öffnende „ reicht in Archivo Black weit
     unter die Grundlinie. Bei zu engem Durchschuss stößt es in die Folgezeile
     und liest sich wie ein verirrtes Zeichen. 1.3 gibt ihm Platz,
     text-wrap: balance verteilt die Zeilen gleichmäßiger. */
  .post-h1 {
    line-height: 1.3;
    text-wrap: balance;
  }

  .post-hero-image {
    position: relative;
    max-width: 28rem;
    margin-left: auto;
    margin-right: auto;
    padding: 0;
    background: #0f0f0f;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 30px 60px rgba(0, 0, 0, 0.55),
      0 6px 12px rgba(247, 147, 26, 0.08),
      inset 0 0 0 1px rgba(255, 255, 255, 0.04);
    transform: rotate(-1.3deg);
    transition: transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .post-hero-image:hover {
    transform: rotate(0deg);
  }
  /* Klebeband oben in der Mitte */
  .post-hero-image::before {
    content: "";
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%) rotate(-2deg);
    width: 88px;
    height: 24px;
    background: rgba(247, 147, 26, 0.65);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
    z-index: 2;
    pointer-events: none;
  }
  .post-hero-image img {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .post-hero-image,
    .post-hero-image:hover {
      transform: none;
      transition: none;
    }
  }

  .post-body {
    color: rgb(from var(--color-paper) r g b / 0.85);
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .post-body > * + * {
    margin-top: 1.25em;
  }
  .post-body h2 {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.1;
    font-size: 1.75rem;
    color: var(--color-paper);
    margin-top: 2.5em;
  }
  .post-body h3 {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    font-size: 1.25rem;
    color: var(--color-paper);
    margin-top: 2em;
  }
  .post-body a {
    color: var(--color-paper);
    text-decoration: underline;
    text-decoration-color: rgb(from var(--color-orange) r g b / 0.6);
    text-underline-offset: 0.15em;
  }
  .post-body a:hover {
    color: var(--color-orange);
  }
  .post-body strong {
    color: var(--color-paper);
  }
  .post-body ul, .post-body ol {
    padding-left: 1.5em;
  }
  .post-body ul {
    list-style: disc;
  }
  .post-body ol {
    list-style: decimal;
  }
  .post-body li + li {
    margin-top: 0.5em;
  }
  .post-body blockquote {
    border-left: 3px solid var(--color-orange);
    padding-left: 1rem;
    color: rgb(from var(--color-paper) r g b / 0.9);
    font-style: italic;
  }
  .post-body code {
    background: rgba(255, 255, 255, 0.08);
    padding: 0.15em 0.35em;
    border-radius: 0.25em;
    font-size: 0.9em;
  }
</style>
