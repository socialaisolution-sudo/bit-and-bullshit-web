---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SocialLinks from "../components/SocialLinks.astro";

const zielgruppe = [
  "spürst, dass mit Geld, Staat und Krypto was nicht rund läuft — und keinen Bock mehr auf Vereinfachungen und Panik-Schlagzeilen hast",
  "eigene Entscheidungen über Sparen, Investieren, Vorsorge treffen willst — und dafür Grundverständnis brauchst statt Geheimtipps",
  "Distanz zu Guru-Gebrüll und Parteilagern hältst — und trotzdem klare Analysen brauchst",
  "Mathematik über Meinungen stellst — auch wenn die Mathematik unbequemer ist",
];

const prinzipien = [
  {
    nr: "01",
    titel: "Mechanik vor Moral.",
    text: "Wir fragen nicht „Ist das gerecht?“, sondern „Wie funktioniert das strukturell — und wer verdient dabei?“ Werturteile bleiben bei dir.",
  },
  {
    nr: "02",
    titel: "Kurz vor Vollständig.",
    text: "Ein Snippet passt in 60 Sekunden. Wer tiefer will, findet die Langfassung als Artikel im Blog oder — bei Bitcoin-Grundlagen — auf bitcoinaera.de.",
  },
  {
    nr: "03",
    titel: "Ehrlich vor Bequem.",
    text: "Wenn etwas kaputt läuft, sagen wir das. Wenn etwas nicht klar ist, sagen wir das auch. Kein „diesmal ist alles anders“, kein „garantierter Gewinn“. Diese Sätze kommen auf Bit & Bullshit nie vor — außer wir zerlegen sie.",
  },
  {
    nr: "04",
    titel: "Positionierung ohne Lagerbindung.",
    text: "Wir sind für gesundes Geld, klare Regeln und persönliche Souveränität — und gegen jede Form von Bullshit-Verkauf. Das ist keine Parteizugehörigkeit. Wir haben keine Wahlempfehlung, keine Kandidaten-Präferenz, keine Lager-Anlehnung. Nur eine Haltung.",
  },
];

const nichtIst = [
  {
    kopf: "Keine Anlageberatung.",
    text: "Wir analysieren Strukturen, nicht deine individuelle Situation. Konkrete Investitions-, Vorsorge- oder Steuerentscheidungen gehören zu einem qualifizierten Berater.",
  },
  {
    kopf: "Keine Signale, kein Bot-Verkauf.",
    text: "Wir sagen dir nicht „Kauf jetzt“. Wir zeigen dir, warum genau das der Satz ist, bei dem du hellhörig werden solltest.",
  },
  {
    kopf: "Kein Shop, kein Abo, kein Newsletter-Zwang.",
    text: "Alles hier ist frei zugänglich. Bit & Bullshit ist ein rein informatives Non-Profit-Projekt.",
  },
  {
    kopf: "Kein politisches Programm.",
    text: "Wir haben keine Wahlempfehlung und keine Lagerzugehörigkeit.",
  },
  {
    kopf: "Keine Untergangs-Verkündigung.",
    text: "Wir verkaufen keine Weltuntergänge. Wenn was schiefläuft, zerlegen wir es ruhig — ohne Angst-Ökonomie.",
  },
];
---

<Layout
  title="Über — Bit & Bullshit"
  description="Wer wir sind, warum wir das machen, wo unsere Grenzen liegen. Bit & Bullshit erklärt Bitcoin, Makro und Geld — frech, kurz, ehrlich."
>
  <SiteHeader />

  <main class="relative overflow-hidden">
    {/* ===== Hero: Tag an der Wand ===== */}
    <section class="relative mx-auto max-w-5xl px-5 pb-10 pt-12 md:pb-16 md:pt-20">
      <span class="wall-ghost" aria-hidden="true">BULLSHIT</span>

      <p class="display hero-layer text-xs tracking-[0.3em] text-orange">// ÜBER</p>
      <h1
        class="display spray-head hero-layer mt-5 text-[clamp(2.6rem,9vw,5.6rem)]"
      >
        Warum wir<br />
        das <span class="marker">machen.</span>
      </h1>

      <p class="hero-layer mt-8 max-w-2xl text-lg leading-relaxed text-paper/85 md:text-xl">
        Immer mehr Leute spüren, dass etwas nicht stimmt. Preise steigen, Sparen
        lohnt nicht mehr, Immobilien fressen Geld, Aktien-Guru wollen dir was
        verkaufen, Bitcoin ist angeblich „für Kriminelle“, und wer eine
        unbequeme Frage stellt, kriegt eine Schlagzeile als Antwort.
      </p>
    </section>

    {/* ===== Manifest: der Satz als Wand-Tag ===== */}
    <section class="relative mx-auto max-w-5xl px-5 pb-8 md:pb-12">
      <blockquote class="wall-tag">
        <span>Das System ist nicht zufällig.</span>
        <span class="wall-tag-hit">Es ist gebaut.</span>
      </blockquote>

      <div class="mt-10 grid gap-6 md:grid-cols-2 md:gap-10">
        <p class="text-lg leading-relaxed text-paper/80">
          Nur erklärt das kaum jemand ehrlich. Die einen reden zu kompliziert,
          die anderen verkaufen Panik oder das nächste Wunder-Signal.
        </p>
        <p class="text-lg leading-relaxed text-paper/80">
          Bit &amp; Bullshit ist der Versuch, das anders zu machen:
          <strong class="text-paper">frech, kurz, ehrlich.</strong>
          Kein Rendite-Guru, kein Signaldienst, keine Monatsabos.
          Ein Kanal, der ein Thema in 60 Sekunden auseinandernimmt — und
          dir dabei nicht sagt, was du tun sollst, sondern zeigt, was
          wirklich läuft.
        </p>
      </div>
    </section>

    {/* ===== 01 Für wen — Zettel an der Wand ===== */}
    <section class="wall-sec">
      <div class="mx-auto max-w-5xl px-5">
        <header class="wall-head">
          <span class="stencil-num wall-head-num" aria-hidden="true">01</span>
          <h2 class="display wall-h">Für wen</h2>
        </header>
        <div class="spray-rule mt-4 max-w-[14rem]"></div>

        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-paper/80">
          Für Leute, die spüren, dass die Antworten aus Talkshows und
          Werbe-Reels nicht reichen. Die nicht nur konsumieren, sondern
          verstehen wollen. Die wissen, dass das eigene Urteil besser wird,
          je besser man die Mechanik dahinter kapiert.
        </p>
        <p class="display mt-8 text-sm tracking-[0.2em] text-orange">
          Konkret: Für dich, wenn du
        </p>

        <ul class="zettel-grid mt-8">
          {
            zielgruppe.map((eintrag) => (
              <li class="zettel paper tape">
                <span class="zettel-mark" aria-hidden="true">✕</span>
                <span>{eintrag}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ===== 02 Wer dahinter steht — Steckbrief ===== */}
    <section class="wall-sec">
      <div class="mx-auto max-w-5xl px-5">
        <header class="wall-head">
          <span class="stencil-num wall-head-num" aria-hidden="true">02</span>
          <h2 class="display wall-h">Wer dahinter steht</h2>
        </header>
        <div class="spray-rule mt-4 max-w-[14rem]"></div>

        <div class="steckbrief paper tape tape-left mt-10">
          <p class="steckbrief-kicker">Redaktionell verantwortlich</p>
          <p class="steckbrief-name display">Denny Guhlmann</p>

          <div class="steckbrief-stamps">
            <span class="stamp">Jahrzehnte Vertrieb</span>
            <span class="stamp">Master Consultant of Finance</span>
            <span class="stamp">Immobilienbetriebswirt (ADI)</span>
          </div>

          <div class="steckbrief-body">
            <p>
              Bit &amp; Bullshit wird redaktionell verantwortet von
              <strong>Denny Guhlmann</strong>, ansässig in Chemnitz. Rechtlich
              verantwortlich ist derselbe — vollständig ausgewiesen im
              <a href="/impressum" class="paper-link">Impressum</a>.
            </p>
            <p>
              Denny war jahrzehntelang im Vertrieb —
              <strong>Master Consultant of Finance</strong> und
              <strong>Immobilienbetriebswirt (ADI)</strong> — mit direktem
              Einblick, wie Produkte, Provisionen und Verkaufsversprechen in
              Finanz- und Immobilienbranche wirklich funktionieren. Diese
              Praxiserfahrung ist der Filter, durch den Bit &amp; Bullshit auf
              Krypto-Guru, Signaldienste und Rendite-Märchen schaut. Was hier
              steht, kommt nicht aus dem Lehrbuch, sondern aus der Realität von
              der anderen Seite des Tisches.
            </p>
            <p>
              Für tieferes Fachwissen zu Bitcoin selbst verweisen wir auf
              <a href="https://bitcoinaera.de" class="paper-link" rel="noopener">
                bitcoinaera.de
              </a> — das Referenz-Projekt für die Enzyklopädie-Tiefe.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ===== 03 Wie wir arbeiten — Schablonen-Kacheln ===== */}
    <section class="wall-sec">
      <div class="mx-auto max-w-5xl px-5">
        <header class="wall-head">
          <span class="stencil-num wall-head-num" aria-hidden="true">03</span>
          <h2 class="display wall-h">Wie wir arbeiten</h2>
        </header>
        <div class="spray-rule mt-4 max-w-[14rem]"></div>

        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-paper/80">
          Vier Prinzipien, die jedes Snippet und jeder Text durchläuft:
        </p>

        <div class="prinzip-grid mt-10">
          {
            prinzipien.map((p) => (
              <article class="prinzip">
                <span class="prinzip-num stencil-num" aria-hidden="true">
                  {p.nr}
                </span>
                <h3 class="display prinzip-titel">{p.titel}</h3>
                {p.nr === "02" ? (
                  <p class="prinzip-text">
                    Ein Snippet passt in 60 Sekunden. Wer tiefer will, findet
                    die Langfassung als Artikel im{" "}
                    <a href="/blog" class="legal-link">Blog</a> oder — bei
                    Bitcoin-Grundlagen — auf{" "}
                    <a href="https://bitcoinaera.de" class="legal-link" rel="noopener">
                      bitcoinaera.de
                    </a>
                    .
                  </p>
                ) : (
                  <p class="prinzip-text">{p.text}</p>
                )}
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {/* ===== 04 Werkzeuge — Sprühbalken links ===== */}
    <section class="wall-sec">
      <div class="mx-auto max-w-5xl px-5">
        <header class="wall-head">
          <span class="stencil-num wall-head-num" aria-hidden="true">04</span>
          <h2 class="display wall-h">Zu unseren Werkzeugen</h2>
        </header>
        <div class="spray-rule mt-4 max-w-[14rem]"></div>

        <div class="werkzeug mt-9 max-w-3xl">
          <p>
            Bit &amp; Bullshit arbeitet mit modernen redaktionellen Werkzeugen.
            Themenauswahl, Positionierung, Faktenprüfung und redaktionelle
            Verantwortung liegen ausschließlich beim Autor. Für Textformulierung,
            Struktur und Layout kommen KI-gestützte Werkzeuge zum Einsatz — so
            wie klassische Redaktionen mit Rechercheuren und Textredakteuren
            arbeiten. Die Handschrift bleibt beim Menschen davor.
          </p>
          <p>
            Was das für dich heißt: Die Faktenbasis ist geprüft. Die Linie ist
            gesetzt und wird konsistent gehalten. Dass moderne Werkzeuge dabei
            helfen, ändert nichts an der redaktionellen Verantwortung.
          </p>
        </div>
      </div>
    </section>

    {/* ===== 05 Was es NICHT ist — Verbots-Stempel ===== */}
    <section class="wall-sec">
      <div class="mx-auto max-w-5xl px-5">
        <header class="wall-head">
          <span class="stencil-num wall-head-num" aria-hidden="true">05</span>
          <h2 class="display wall-h">
            Was Bit &amp; Bullshit <span class="text-orange">NICHT</span> ist
          </h2>
        </header>
        <div class="spray-rule mt-4 max-w-[14rem]"></div>

        <p class="mt-7 text-lg leading-relaxed text-paper/80">
          Fürs klare Erwartungsmanagement:
        </p>

        <div class="nope-grid mt-9">
          {
            nichtIst.map((n) => (
              <div class="nope">
                <span class="nope-x" aria-hidden="true">✕</span>
                <p class="display nope-kopf">{n.kopf}</p>
                <p class="nope-text">{n.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* ===== 06 Kontakt — geklebtes Panel ===== */}
    <section class="wall-sec pb-4">
      <div class="mx-auto max-w-5xl px-5">
        <header class="wall-head">
          <span class="stencil-num wall-head-num" aria-hidden="true">06</span>
          <h2 class="display wall-h">Kontakt &amp; Kanäle</h2>
        </header>
        <div class="spray-rule mt-4 max-w-[14rem]"></div>

        <div class="kontakt tape tape-right mt-10">
          <p class="max-w-2xl text-lg leading-relaxed text-paper/85">
            Bit &amp; Bullshit lebt auf TikTok und Instagram — dort landen die
            neuen Snippets zuerst. Der Blog ist die Zweitverwertung zum
            Nachlesen. Fragen, Themen-Wünsche oder ein Sticker-Request?
            Schreib uns direkt.
          </p>

          <a href="mailto:hello@bitandbullshit.com" class="mail-tag display">
            hello@bitandbullshit.com
          </a>

          <div class="mt-8">
            <SocialLinks size="lg" />
          </div>
        </div>
      </div>
    </section>

    {/* ===== Disclaimer als Klebeband-Streifen ===== */}
    <div class="mx-auto max-w-5xl px-5 pb-20 pt-14">
      <p class="disclaimer-tape">
        Nur Meinung &amp; Unterhaltung. Keine Finanz-, Steuer- oder
        Rechtsberatung. <strong>Klarheit statt Bullshit.</strong>
      </p>
    </div>
  </main>

  <SiteFooter />
</Layout>

<style>
  /* ---- Hero: Geister-Tag an der Betonwand ---- */
  /* z-index 0 statt -1: body trägt eine deckende Hintergrundfarbe, ein
     negativer Index würde den Tag dahinter schieben und unsichtbar machen.
     Die Textebenen darüber bekommen deshalb explizit z-index 1. */
  .wall-ghost {
    position: absolute;
    top: 2.5rem;
    right: -1.5rem;
    z-index: 0;
    font-family: var(--font-display);
    font-size: clamp(4rem, 16vw, 11rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 2px rgb(from var(--color-paper) r g b / 0.07);
    transform: rotate(-7deg);
    user-select: none;
    white-space: nowrap;
  }
  .hero-layer {
    position: relative;
    z-index: 1;
  }

  /* ---- Manifest-Tag ---- */
  .wall-tag {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 0.98;
    font-size: clamp(1.5rem, 5.2vw, 3.1rem);
    transform: rotate(-1.4deg);
  }
  .wall-tag span {
    display: inline-block;
  }
  .wall-tag-hit {
    color: var(--color-ink);
    background: var(--color-orange);
    padding: 0.1em 0.35em 0.16em;
    transform: rotate(1.1deg);
    box-shadow: 0 8px 20px -6px rgba(247, 147, 26, 0.45);
  }

  /* ---- Sektions-Kopf mit Schablonen-Ziffer ---- */
  .wall-sec {
    position: relative;
    padding-top: 2.75rem;
    padding-bottom: 2.75rem;
  }
  @media (min-width: 768px) {
    .wall-sec {
      padding-top: 3.75rem;
      padding-bottom: 3.75rem;
    }
  }
  .wall-head {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
  }
  .wall-head-num {
    font-size: clamp(2.6rem, 8vw, 4.6rem);
    flex: none;
  }
  .wall-h {
    font-size: clamp(1.5rem, 5vw, 2.6rem);
    line-height: 1.02;
    transform: rotate(-0.8deg);
  }
  .wall-sec:nth-of-type(even) .wall-h {
    transform: rotate(0.7deg);
  }

  /* ---- 01: Zettel-Wand ---- */
  .zettel-grid {
    display: grid;
    gap: 2rem 1.5rem;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    list-style: none;
    padding: 0;
  }
  @media (min-width: 700px) {
    .zettel-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.25rem 2rem;
    }
  }
  .zettel {
    display: flex;
    gap: 0.75rem;
    padding: 1.5rem 1.25rem 1.35rem;
    font-size: 0.98rem;
    line-height: 1.55;
    color: rgb(from var(--color-ink) r g b / 0.88);
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .zettel-grid > .zettel:nth-child(4n + 1) {
    transform: rotate(-1.8deg);
  }
  .zettel-grid > .zettel:nth-child(4n + 2) {
    transform: rotate(1.4deg);
  }
  .zettel-grid > .zettel:nth-child(4n + 3) {
    transform: rotate(1.1deg);
  }
  .zettel-grid > .zettel:nth-child(4n + 4) {
    transform: rotate(-1.2deg);
  }
  .zettel:hover {
    transform: rotate(0deg) translateY(-4px);
  }
  .zettel-mark {
    flex: none;
    font-family: var(--font-display);
    font-size: 1.1rem;
    line-height: 1.35;
    color: var(--color-orange-deep);
  }

  /* ---- 02: Steckbrief ---- */
  .steckbrief {
    padding: 2rem 1.5rem 1.75rem;
    transform: rotate(-0.9deg);
    max-width: 46rem;
  }
  @media (min-width: 768px) {
    .steckbrief {
      padding: 2.5rem 2.25rem 2rem;
    }
  }
  .steckbrief-kicker {
    font-family: var(--font-display);
    font-size: 0.68rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgb(from var(--color-ink) r g b / 0.5);
  }
  .steckbrief-name {
    margin-top: 0.35rem;
    font-size: clamp(1.8rem, 6vw, 2.9rem);
    color: var(--color-ink);
  }
  .steckbrief-stamps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }
  .steckbrief-stamps .stamp:nth-child(1) {
    transform: rotate(-1.6deg);
  }
  .steckbrief-stamps .stamp:nth-child(2) {
    transform: rotate(1.2deg);
  }
  .steckbrief-stamps .stamp:nth-child(3) {
    transform: rotate(-0.8deg);
  }
  .steckbrief-body {
    margin-top: 1.5rem;
    color: rgb(from var(--color-ink) r g b / 0.82);
    line-height: 1.65;
    font-size: 0.98rem;
  }
  .steckbrief-body p + p {
    margin-top: 0.9em;
  }
  .steckbrief-body strong {
    color: var(--color-ink);
  }
  .paper-link {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-orange);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }
  .paper-link:hover {
    color: var(--color-orange-deep);
  }

  /* ---- 03: Prinzipien-Kacheln ---- */
  .prinzip-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(1, minmax(0, 1fr));
  }
  @media (min-width: 700px) {
    .prinzip-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }
  .prinzip {
    position: relative;
    overflow: hidden;
    padding: 1.5rem 1.35rem 1.4rem;
    border: 1px solid rgb(from var(--color-paper) r g b / 0.12);
    border-radius: 0.4rem;
    background: rgb(from var(--color-paper) r g b / 0.03);
    transition:
      border-color 220ms ease,
      background 220ms ease;
  }
  .prinzip:hover {
    border-color: rgb(from var(--color-orange) r g b / 0.45);
    background: rgb(from var(--color-orange) r g b / 0.05);
  }
  .prinzip-num {
    position: absolute;
    top: -0.6rem;
    right: 0.35rem;
    font-size: 4.5rem;
    -webkit-text-stroke-width: 2px;
    -webkit-text-stroke-color: rgb(from var(--color-orange) r g b / 0.22);
  }
  .prinzip-titel {
    position: relative;
    font-size: 1.05rem;
    color: var(--color-orange);
    letter-spacing: 0;
    line-height: 1.15;
  }
  .prinzip-text {
    position: relative;
    margin-top: 0.6rem;
    color: rgb(from var(--color-paper) r g b / 0.78);
    line-height: 1.65;
    font-size: 0.97rem;
  }

  /* ---- 04: Werkzeuge mit Sprüh-Kante ---- */
  .werkzeug {
    position: relative;
    padding-left: 1.5rem;
    color: rgb(from var(--color-paper) r g b / 0.8);
    line-height: 1.7;
    font-size: 1.02rem;
  }
  .werkzeug::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.4rem;
    bottom: 0.4rem;
    width: 4px;
    border-radius: 2px;
    background: linear-gradient(
      180deg,
      var(--color-orange),
      rgb(from var(--color-orange-deep) r g b / 0.25)
    );
    transform: rotate(0.5deg);
  }
  .werkzeug p + p {
    margin-top: 0.9em;
  }

  /* ---- 05: Verbots-Karten ---- */
  .nope-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(1, minmax(0, 1fr));
  }
  @media (min-width: 700px) {
    .nope-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
  .nope {
    position: relative;
    padding: 1.35rem 1.25rem 1.25rem 3.25rem;
    border: 1px dashed rgb(from var(--color-orange) r g b / 0.35);
    border-radius: 0.4rem;
    background: rgb(from var(--color-ink) r g b / 0.4);
  }
  .nope-x {
    position: absolute;
    left: 1.1rem;
    top: 1.25rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1;
    color: var(--color-orange);
    transform: rotate(-8deg);
  }
  .nope-kopf {
    font-size: 0.95rem;
    line-height: 1.2;
    color: var(--color-paper);
  }
  .nope-text {
    margin-top: 0.5rem;
    color: rgb(from var(--color-paper) r g b / 0.72);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* ---- 06: Kontakt-Panel ---- */
  .kontakt {
