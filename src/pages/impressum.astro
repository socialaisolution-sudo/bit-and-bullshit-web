---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Impressum — Bit & Bullshit" description="Angaben gemäß § 5 TMG.">
  <main class="mx-auto max-w-3xl px-5 py-16">
    <a href="/" class="text-sm uppercase tracking-widest text-paper/60 hover:text-orange">&larr; Back</a>
    <h1 class="display mt-6 text-4xl md:text-5xl">Impressum</h1>
    <p class="mt-4 text-sm text-paper/60">Angaben gemäß § 5 TMG.</p>

    <section class="prose prose-invert mt-10 space-y-4 text-paper/80">
      <p class="rounded-lg border border-orange/40 bg-orange/10 p-4 text-sm text-paper">
        <strong class="text-orange">TODO Denny:</strong> Echten Impressumstext einsetzen
        (Name, Anschrift, Kontakt, ggf. USt-IdNr., Verantwortlicher i.S.d. § 18 Abs. 2 MStV).
      </p>

      <h2 class="display text-xl text-paper">Anbieter</h2>
      <p>
        [Vor- und Nachname]<br />
        [Straße Hausnummer]<br />
        [PLZ Ort]<br />
        Deutschland
      </p>

      <h2 class="display text-xl text-paper">Kontakt</h2>
      <p>E-Mail: [kontakt@bit-and-bullshit.com]</p>

      <h2 class="display text-xl text-paper">Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
      <p>[Vor- und Nachname], Anschrift wie oben.</p>

      <h2 class="display text-xl text-paper">Haftungshinweis</h2>
      <p class="text-sm">
        Trotz sorgfältiger inhaltlicher Kontrolle übernehmen wir keine Haftung für die
        Inhalte externer Links. Für den Inhalt der verlinkten Seiten sind ausschließlich
        deren Betreiber verantwortlich.
      </p>
    </section>
  </main>
</Layout>
