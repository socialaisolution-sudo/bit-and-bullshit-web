---
import Layout from "../layouts/Layout.astro";
import SignupForm from "../components/SignupForm.astro";
import mascot from "../assets/mascot-placeholder.svg?url";
---

<Layout>
  <main class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10 opacity-[0.07]"
      style="background-image: radial-gradient(circle at 1px 1px, #f5f4ef 1px, transparent 0); background-size: 28px 28px;"
      aria-hidden="true"
    >
    </div>
    <div class="pointer-events-none absolute -top-32 -right-32 -z-10 size-[28rem] rounded-full bg-orange/15 blur-3xl" aria-hidden="true"></div>

    <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-5">
      <a href="/" class="display text-xl tracking-tight">
        Bit <span class="text-orange">&amp;</span> Bullshit
      </a>
      <span class="hidden text-xs uppercase tracking-widest text-paper/50 sm:block">
        Triple B — the honest starter guide
      </span>
    </nav>

    <section class="mx-auto grid max-w-6xl items-center gap-12 px-5 pb-16 pt-6 md:grid-cols-[1.1fr_1fr] md:gap-10 md:pb-24 md:pt-10">
      <div>
        <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs uppercase tracking-widest text-paper/70">
          <span class="size-1.5 rounded-full bg-orange"></span>
          Free guide · No signals · No subscription
        </p>
        <h1 class="display text-[clamp(2.4rem,7vw,4.6rem)]">
          Your feed is full of <span class="text-orange">crypto signal sellers.</span><br />
          Here's how to <span class="drip-underline text-ink">build the bot yourself.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-paper/80 leading-relaxed">
          Free guide. No fluff, no signals, no monthly subscription. Just the honest
          starting point for building your own crypto trading bot — even if you've
          never written a line of code.
        </p>
        <SignupForm id="signup-hero" />
      </div>

      <div class="flex justify-center md:justify-end">
        <img
          src={mascot}
          alt="Bit & Bullshit mascot — graffiti drip smiley with a Bitcoin cap"
          width="320"
          height="320"
          class="mascot w-64 sm:w-80 md:w-[22rem]"
        />
      </div>
    </section>

    <section class="border-t border-white/10 bg-white/[0.02]">
      <div class="mx-auto max-w-6xl px-5 py-16 md:py-24">
        <h2 class="display text-3xl text-paper md:text-5xl">
          What you actually get.
        </h2>
        <ul class="mt-10 grid gap-6 md:grid-cols-2">
          <li class="group rounded-2xl border border-white/10 bg-ink/60 p-6 transition hover:border-orange/60">
            <p class="display text-2xl text-orange">01</p>
            <p class="mt-3 text-lg text-paper">
              The 5 building blocks of a bot, in plain language — what each one is and why it matters.
            </p>
          </li>
          <li class="group rounded-2xl border border-white/10 bg-ink/60 p-6 transition hover:border-orange/60">
            <p class="display text-2xl text-orange">02</p>
            <p class="mt-3 text-lg text-paper">
              What it really costs to start (spoiler: less than one month of a signal subscription).
            </p>
          </li>
          <li class="group rounded-2xl border border-white/10 bg-ink/60 p-6 transition hover:border-orange/60">
            <p class="display text-2xl text-orange">03</p>
            <p class="mt-3 text-lg text-paper">
              The honest part: what's hard, what's easy, and whether this is even for you.
            </p>
          </li>
          <li class="group rounded-2xl border border-white/10 bg-ink/60 p-6 transition hover:border-orange/60">
            <p class="display text-2xl text-orange">04</p>
            <p class="mt-3 text-lg text-paper">
              Zero signals. Zero "get rich" promises. The machine is yours — what you do with it is on you.
            </p>
          </li>
        </ul>
      </div>
    </section>

    <section class="relative">
      <div class="mx-auto max-w-3xl px-5 py-20 md:py-28">
        <p class="display text-xs tracking-[0.3em] text-orange">// REAL TALK</p>
        <h2 class="display mt-4 text-3xl md:text-5xl">
          Real talk before you sign up.
        </h2>
        <p class="mt-6 text-lg text-paper/80 leading-relaxed">
          If you want a magic button that prints money while you sleep —
          <span class="text-paper">close this tab.</span>
          That's the exact bullshit we're against. But if you want to actually
          <span class="drip-underline text-ink">understand and own the machine</span>
          instead of renting someone else's signals forever — you're in the right place.
        </p>
      </div>
    </section>

    <section id="get-the-guide" class="border-t border-white/10 bg-gradient-to-b from-ink to-black">
      <div class="mx-auto max-w-2xl px-5 py-20 md:py-28">
        <h2 class="display text-3xl md:text-5xl">
          Get the <span class="text-orange">honest starter guide.</span>
        </h2>
        <p class="mt-4 text-base text-paper/70">
          One email. The guide lands in your inbox after you confirm.
        </p>
        <SignupForm id="signup-cta" cta="Send me the free guide" />
      </div>
    </section>

    <footer class="border-t border-white/10 bg-black">
      <div class="mx-auto flex max-w-6xl flex-col gap-6 px-5 py-10 text-sm text-paper/60 md:flex-row md:items-center md:justify-between">
        <div>
          <p class="display text-base text-paper">
            Bit <span class="text-orange">&amp;</span> Bullshit
          </p>
          <p class="mt-1 max-w-xl text-xs leading-relaxed">
            Educational content only. Not financial advice. We don't sell signals or manage money.
          </p>
        </div>
        <nav class="flex flex-wrap gap-x-6 gap-y-2 text-xs uppercase tracking-widest">
          <a href="/impressum" class="hover:text-orange">Impressum</a>
          <a href="/datenschutz" class="hover:text-orange">Datenschutz</a>
        </nav>
      </div>
    </footer>
  </main>
</Layout>
