---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SocialLinks from "../components/SocialLinks.astro";
import StickerWall from "../components/StickerWall.astro";
import RatgeberKarten from "../components/RatgeberKarten.astro";
import RatgeberFortschritt from "../components/RatgeberFortschritt.astro";
import { aktuellerCornerstone } from "../lib/ratgeber";
import mascot from "../assets/mascot-hero.png";
import comicPanel from "../assets/comic/zu-spaet-gibt-es-nicht/03-kreiszug.webp";
import { Image } from "astro:assets";

/* Der zuletzt veröffentlichte Cornerstone ist der Aufmacher. Fehlt er
   (frische Installation, alles auf draft), entfällt der Abschnitt still —
   ein leerer Kasten mit „demnächst" ist schlechter als keiner. */
const aufmacher = await aktuellerCornerstone();

const site = Astro.site ?? new URL("https://bitandbullshit.com");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Bit & Bullshit",
  url: site.toString(),
  logo: new URL("/apple-touch-icon.png", site).toString(),
  description:
    "Bitcoin, Makro und Geld ohne Rendite-Bullshit. Kurze Erklär-Snippets, ehrlicher Ton, keine Signale.",
  sameAs: [
    "https://www.tiktok.com/@bitandbullshit",
    "https://www.instagram.com/bitandbullshit",
  ],
};
---

<Layout jsonLd={jsonLd}>
  <SiteHeader />

  <main class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10 opacity-[0.07]"
      style="background-image: radial-gradient(circle at 1px 1px, #f5f4ef 1px, transparent 0); background-size: 28px 28px;"
      aria-hidden="true"
    >
    </div>
    <div class="pointer-events-none absolute -top-32 -right-32 -z-10 size-[28rem] rounded-full bg-orange/15 blur-3xl" aria-hidden="true"></div>

    <section class="mx-auto grid max-w-6xl items-center gap-12 px-5 pb-16 pt-10 md:grid-cols-[1fr_1.05fr] md:gap-14 md:pb-24 md:pt-16">
      <div class="relative order-2 md:order-1">
        <span class="wall-ghost" aria-hidden="true">MAKRO</span>
        <p class="stamp stamp-dark hero-stamp">Bitcoin · Makro · Geld</p>
        <h1 class="display spray-head hero-layer mt-5 text-[clamp(2.4rem,7vw,4.8rem)]">
          Bitcoin. Makro. Geld.<br />
          Wir entlarven den <span class="text-orange">Bullshit.</span>
        </h1>
        <p class="hero-layer mt-6 max-w-xl text-lg leading-relaxed text-paper/80">
          Frech, kurz, ehrlich. Kein Signaldienst, keine „100 % Rendite"-Märchen,
          keine Monatsabos. Nur die unbequemen Fragen zu Geldsystem, Staat und
          Krypto — verständlich aufbereitet.
        </p>

        <div class="hero-layer mt-8">
          <SocialLinks size="lg" />
        </div>

        <p class="hero-layer mt-6 text-sm text-paper/50">
          Du willst tiefer einsteigen? Echtes Fachwissen zu Bitcoin gibt&apos;s auf
          <a href="https://bitcoinaera.de" class="drip-underline text-paper hover:text-orange" rel="noopener">bitcoinaera.de</a>.
        </p>
      </div>

      <div class="order-1 flex justify-center md:order-2 md:justify-end">
        <div class="hero-sticker w-64 sm:w-80 md:w-[26rem]">
          <Image
            src={mascot}
            alt="Bit & Bullshit Maskottchen zeigt auf dich mit Graffiti-Claim „Mehr Bitcoin. Weniger Bullshit.“"
            widths={[320, 480, 640, 800]}
            sizes="(min-width: 768px) 26rem, 18rem"
            class="block h-auto w-full"
            loading="eager"
          />
        </div>
      </div>
    </section>

    {/* Der lange Text steht vor allem anderen. Die Snippets bringen die
        Leute her, aber sie sind nicht der Grund zu bleiben — der aktuelle
        Ratgeber-Teil ist es. */}
    {
      aufmacher && (
        <section class="relative border-t border-white/10">
          <div class="mx-auto max-w-6xl px-5 py-16 md:py-24">
            <div class="aufmacher">
              <a
                href={`/ratgeber/${aufmacher.ratgeber.id}/${aufmacher.teil.slug}/`}
                class="aufmacher-bild"
                tabindex="-1"
                aria-hidden="true"
              >
                {aufmacher.teil.cornerstone!.data.image && (
                  <Image
                    src={aufmacher.teil.cornerstone!.data.image}
                    alt=""
                    widths={[480, 720, 960]}
                    sizes="(min-width: 900px) 32rem, 92vw"
                    class="block h-auto w-full"
                    loading="lazy"
                  />
                )}
              </a>
              <div>
                <p class="display text-xs tracking-[0.3em] text-orange">
                  // RATGEBER {String(aufmacher.ratgeber.data.nummer).padStart(2, "0")} ·
                  TEIL {aufmacher.teil.nr}
                </p>
                <h2 class="display spray-head mt-4 text-3xl md:text-5xl">
                  {aufmacher.teil.cornerstone!.data.title}
                </h2>
                <div class="spray-rule mt-5 max-w-[14rem]" />
                <p class="mt-5 text-base leading-relaxed text-paper/70">
                  {aufmacher.teil.cornerstone!.data.untertitel ??
                    aufmacher.teil.cornerstone!.data.description}
                </p>
                <div class="mt-7 max-w-[16rem]">
                  <RatgeberFortschritt
                    fertig={aufmacher.ratgeber.fertig}
                    gesamt={aufmacher.ratgeber.gesamt}
                    klein
                  />
                </div>
                <a
                  href={`/ratgeber/${aufmacher.ratgeber.id}/${aufmacher.teil.slug}/`}
                  class="aufmacher-link"
                >
                  Teil {aufmacher.teil.nr} lesen &rarr;
                </a>
              </div>
            </div>
          </div>
        </section>
      )
    }

    <section class="relative border-t border-white/10">
      <div class="mx-auto max-w-6xl px-5 py-16 md:py-24">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div class="max-w-2xl">
            <p class="display text-xs tracking-[0.3em] text-orange">// RATGEBER</p>
            <h2 class="display spray-head mt-4 text-3xl md:text-5xl">
              Zum <span class="text-orange">Durchlesen.</span>
            </h2>
            <div class="spray-rule mt-5 max-w-[14rem]"></div>
            <p class="mt-5 text-base leading-relaxed text-paper/70">
              Wo eine Minute nicht reicht: je fünf Teile, die aufeinander
              aufbauen.
            </p>
          </div>
          <a
            href="/ratgeber"
            class="inline-flex w-fit items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-2 text-xs uppercase tracking-widest text-paper/80 transition hover:border-orange hover:text-orange"
          >
            Alle Ratgeber &rarr;
          </a>
        </div>

        <div class="mt-10 md:mt-14">
          <RatgeberKarten limit={4} stufe={3} />
        </div>
      </div>
    </section>

    <section class="border-t border-white/10 bg-white/[0.02]">
      <div class="mx-auto max-w-4xl px-5 py-16 md:py-24">
        <p class="display text-xs tracking-[0.3em] text-orange">// WER / WAS</p>
        <h2 class="display spray-head mt-4 text-3xl md:text-5xl">
          Wer oder was ist Bit &amp; Bullshit?
        </h2>
        <div class="spray-rule mt-5 max-w-[14rem]"></div>

        <p class="mt-8 max-w-2xl text-lg leading-relaxed text-paper/80">
          Ein Kanal für Leute, die keine Lust mehr auf Rendite-Gurus,
          Signal-Verkäufer und „Number-go-up"-Predigten haben.
          Wir nehmen ein Thema — Fiatgeld, Staatsschulden, Halving,
          Chatkontrolle, Memecoins — und erklären in 60 Sekunden, was
          wirklich dahinter steckt.
        </p>

        <blockquote class="wall-tag mt-10">
          <span>Kein Signaldienst. Kein Bot-Verkauf.</span>
          <span class="wall-tag-hit">Kein „Kauf jetzt sofort".</span>
        </blockquote>

        <p class="mt-9 max-w-2xl text-lg leading-relaxed text-paper/80">
          Sondern: das Werkzeug, mit dem du selbst besser einordnen kannst,
          was gerade in Politik, Wirtschaft und Krypto passiert —
          und wo der Bullshit anfängt.
        </p>
      </div>
    </section>

    {/* Comic vor den Snippets. Es ist das stärkste Bild der Seite und der
        beste Grund zu bleiben — es gehört nicht zwei Klicks tief unter einen
        Ratgeber-Teil. Kein eigener Menüpunkt, solange es einen einzigen gibt:
        Eine Leiste, die einen Bereich verspricht und auf eine Einzelseite
        führt, wirkt unfertig. */}
    <section class="relative border-t border-white/10">
      <div class="mx-auto max-w-6xl px-5 py-16 md:py-24">
        <div class="comic-teaser">
          <a href="/comic/zu-spaet-gibt-es-nicht/" class="comic-teaser-bild">
            <Image
              src={comicPanel}
              alt="Comic-Panel: Das Maskottchen sieht einem Zug zu, der auf einem Kreisgleis fährt statt abzufahren."
              widths={[480, 720, 960]}
              sizes="(min-width: 900px) 30rem, 92vw"
              class="block h-auto w-full"
              loading="lazy"
            />
          </a>
          <div class="comic-teaser-text">
            <p class="display text-xs tracking-[0.3em] text-orange">// COMIC</p>
            <h2 class="display spray-head mt-4 text-3xl md:text-5xl">
              Zu spät gibt es <span class="text-orange">nicht.</span>
            </h2>
            <div class="spray-rule mt-5 max-w-[14rem]"></div>
            <p class="mt-5 text-base leading-relaxed text-paper/70">
              Der große Bitcoin-Denkfehler, Teil 1 — als Comic zum
              Durchscrollen. Fünf Panels, ein Zug, der im Kreis fährt.
            </p>
            <a href="/comic/zu-spaet-gibt-es-nicht/" class="comic-teaser-link">
              Comic ansehen &rarr;
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="relative border-t border-white/10">
      <div class="mx-auto max-w-6xl px-5 py-16 md:py-24">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div class="max-w-2xl">
            <p class="display text-xs tracking-[0.3em] text-orange">// SNIPPETS</p>
            <h2 class="display spray-head mt-4 text-3xl md:text-5xl">
              Kurz erklärt. <span class="text-orange">Klick rein.</span>
            </h2>
            <div class="spray-rule mt-5 max-w-[14rem]"></div>
            <p class="mt-5 text-base leading-relaxed text-paper/70">
              Die Snippets als Wand. Jede Kachel ist ein Artikel — zum Nachlesen,
              wenn dir das Video zu schnell war.
            </p>
          </div>
          <a
            href="/snippets"
            class="inline-flex w-fit items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-2 text-xs uppercase tracking-widest text-paper/80 transition hover:border-orange hover:text-orange"
          >
            Alle Snippets &rarr;
          </a>
        </div>

        <div class="mt-10 md:mt-14">
          <StickerWall limit={9} />
        </div>
      </div>
    </section>

    <section class="relative border-t border-white/10">
      <div class="mx-auto max-w-3xl px-5 py-16 md:py-24">
        <div class="follow-panel tape">
          <p class="display text-xs tracking-[0.3em] text-orange">// FOLLOW</p>
          <h2 class="display spray-head mt-4 text-3xl md:text-5xl">
            Die Snippets gibt&apos;s auf <span class="text-orange">TikTok &amp; Insta.</span>
          </h2>
          <p class="mt-6 text-lg leading-relaxed text-paper/80">
            Neue Videos regelmäßig. Wer lieber liest: die Skripte landen als
            Kurz-Artikel bei den <a href="/snippets" class="drip-underline text-paper hover:text-orange">Snippets</a>.
          </p>
          <div class="mt-8 flex justify-center">
            <SocialLinks size="lg" />
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  /* Bild links, Text rechts — gespiegelt zum Comic-Teaser darunter, damit
     die beiden Blöcke nicht wie zweimal dasselbe wirken. */
  .aufmacher {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .aufmacher {
      grid-template-columns: 1fr 1fr;
    }
  }
  .aufmacher-bild {
    display: block;
    overflow: hidden;
    border: 1px solid rgb(from var(--color-paper) r g b / 0.1);
    border-radius: 0.4rem;
    box-shadow: 0 24px 48px -18px rgba(0, 0, 0, 0.65);
  }
  .aufmacher-link {
    display: inline-block;
    margin-top: 1.75rem;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-orange);
    text-decoration: none;
  }
  .aufmacher-link:hover {
    text-decoration: underline;
  }

  .comic-teaser {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .comic-teaser {
      grid-template-columns: 1.05fr 1fr;
      gap: 3.5rem;
    }
  }
  .comic-teaser-bild {
    display: block;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 24px 50px -20px rgba(0, 0, 0, 0.9);
    transform: rotate(-1.2deg);
    transition: transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .comic-teaser-bild:hover,
  .comic-teaser-bild:focus-visible {
    transform: rotate(0deg);
    outline: none;
  }
  .comic-teaser-link {
    display: inline-block;
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: var(--color-orange);
    border-bottom: 2px solid rgb(from var(--color-orange) r g b / 0.5);
    padding-bottom: 0.3rem;
  }
  .comic-teaser-link:hover {
    border-bottom-color: var(--color-orange);
  }
  @media (prefers-reduced-motion: reduce) {
    .comic-teaser-bild,
    .comic-teaser-bild:hover {
      transform: none;
      transition: none;
    }
  }

  /* Der Hero-Ghost sitzt hinter der Headline-Spalte, nicht hinter dem
     Maskottchen — sonst kämpfen zwei Grafiken um dieselbe Fläche. */
  .wall-ghost {
    top: 5.5rem;
    right: auto;
    left: -3rem;
    font-size: clamp(3.5rem, 11vw, 8rem);
  }

  .follow-panel {
    padding: 2.25rem 1.5rem 2rem;
    border: 1px solid rgb(from var(--color-paper) r g b / 0.12);
    border-radius: 0.4rem;
    background: rgb(from var(--color-paper) r g b / 0.03);
    text-align: center;
    transform: rotate(-0.6deg);
  }
  @media (min-width: 768px) {
    .follow-panel {
      padding: 3rem 2.5rem 2.5rem;
    }
  }
</style>
