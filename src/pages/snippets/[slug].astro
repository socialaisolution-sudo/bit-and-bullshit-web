---
import Layout from "../../layouts/Layout.astro";
import { artikelDaten } from "../../lib/stand";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SocialLinks from "../../components/SocialLinks.astro";
import VerwandteArtikel from "../../components/VerwandteArtikel.astro";
import Brotkrumen from "../../components/Brotkrumen.astro";
import { getCollection, render } from "astro:content";
import { Image, getImage } from "astro:assets";
import type { GetStaticPaths } from "astro";
import { KATEGORIE_MAP } from "../../data/kategorien";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
};

const { post } = Astro.props;
const { Content } = await render(post);
const kat = KATEGORIE_MAP[post.data.kategorie];

/* Kurzfassungs-Regel: Zeigt das Snippet auf einen Cornerstone und gibt es
   den auch schon, gilt der Cornerstone als maßgeblich. Das Snippet bleibt
   lesbar, tritt in der Suche aber nicht mehr gegen ihn an.
   Der Verweis kann gesetzt werden, bevor der Langtext existiert — bis
   dahin passiert nichts. */
const cornerstones = await getCollection("cornerstones", ({ data }) => data.draft !== true);
const langfassung = post.data.langfassung;
const langfassungDa = Boolean(
  langfassung &&
    cornerstones.some((c) => `/ratgeber/${c.id}/` === langfassung),
);
const langfassungTitel = langfassungDa
  ? cornerstones.find((c) => `/ratgeber/${c.id}/` === langfassung)!.data.title
  : undefined;

/* Suchtreffer und Überschrift dürfen auseinanderlaufen: Die H1 bleibt die
   Schlagzeile, der Titel im Tab darf auf die Suchanfrage zielen. Steht ein
   eigener metaTitel, läuft er ohne Marken-Anhängsel — er ist schon auf
   Länge getrimmt, und „ — Bit & Bullshit“ würde ihn bei Google abschneiden. */
const seitenTitel =
  post.data.metaTitel ?? `${post.data.title} — Bit & Bullshit`;

// OG image: use post-specific image (optimized to landscape-ish for social cards) or fall back
/**
 * Seitenverhältnis des Maskottchens. Die Reihe lief bis Juli 2026 hochkant,
 * die neueren Motive kommen im Querformat. Statt jedes Bild einzeln zu
 * behandeln, entscheidet das Bild selbst: Querformat darf breiter laufen,
 * Hochformat bleibt bei der schmalen Spalte, in der es gut aussieht.
 */
const istQuer = Boolean(
  post.data.image && post.data.image.width > post.data.image.height,
);

let ogImagePath: string | undefined;
if (post.data.image) {
  const optimized = await getImage({
    src: post.data.image,
    width: 1200,
    format: "jpg",
  });
  ogImagePath = optimized.src;
}

/* Ist der Cornerstone maßgeblich, entfällt hier die Article-Auszeichnung.
   Zwei Article-Blöcke zum selben Thema wären ein widersprüchliches Signal
   neben dem canonical. */
const site = Astro.site ?? new URL("https://bitandbullshit.com");
const jsonLd = langfassungDa ? undefined : {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  inLanguage: "de-DE",
  url: new URL(`/snippets/${post.id}`, site).toString(),
  mainEntityOfPage: new URL(`/snippets/${post.id}`, site).toString(),
  articleSection: kat.titel,
  keywords: post.data.keyword,
  ...artikelDaten(`src/content/blog/${post.id}.md`),
  image: ogImagePath
    ? new URL(ogImagePath, site).toString()
    : new URL("/og-default.png", site).toString(),
  author: {
    "@type": "Organization",
    name: "Bit & Bullshit",
    url: site.toString(),
  },
  publisher: {
    "@type": "Organization",
    name: "Bit & Bullshit",
    url: site.toString(),
    logo: {
      "@type": "ImageObject",
      url: new URL("/apple-touch-icon.png", site).toString(),
    },
  },
};
---

<Layout
  canonicalUrl={langfassungDa ? langfassung : undefined}
  title={seitenTitel}
  description={post.data.metaBeschreibung ?? post.data.description}
  ogImage={ogImagePath}
  ogType="article"
  jsonLd={jsonLd}
>
  <SiteHeader />

  <main class="mx-auto max-w-3xl px-5 py-16 md:py-24">
    <Brotkrumen
      pfad={[
        { label: "Start", href: "/" },
        { label: "Snippets", href: "/snippets/" },
        { label: kat.titel, href: `/kategorie/${post.data.kategorie}/` },
        { label: post.data.title },
      ]}
    />

    <article
      class="mt-8"
      data-pagefind-body
      data-pagefind-meta={`category:${kat.titel}`}
    >
      {/* Der Kicker ist zugleich der Weg in die Rubrik. Ein Leser, der hier
          landet, soll die Nachbarartikel mit einem Klick erreichen. */}
      <p class="display text-xs tracking-[0.3em] text-orange" data-pagefind-ignore>
        <a href={`/kategorie/${post.data.kategorie}/`} class="transition hover:text-paper">
          // {kat.titel}
        </a>
      </p>
      <h1 class="post-h1 display mt-4 text-3xl md:text-5xl">
        {post.data.title}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-paper/80">
        {post.data.description}
      </p>

      {
        langfassungDa && (
          <a href={langfassung} class="langfassung-hinweis" data-pagefind-ignore>
            <span class="display langfassung-kicker">// Ausführliche Fassung</span>
            <span class="langfassung-text">
              Das hier ist die Kurzfassung. Den ganzen Gedanken mit Beispielen
              gibt es als „{langfassungTitel}“ im Ratgeber.
            </span>
            <span class="display langfassung-link">Zum ausführlichen Text &rarr;</span>
          </a>
        )
      }

      {
        post.data.draft && (
          <div class="mt-8 rounded-lg border border-orange/40 bg-orange/10 p-4 text-sm text-paper/80">
            <strong class="text-orange">Entwurf:</strong> Der Fließtext folgt in Kürze.
            Bis dahin: Video auf TikTok/Insta ansehen.
          </div>
        )
      }

      {
        post.data.image && (
          <figure class:list={["post-hero-image", "mt-10", istQuer && "ist-quer"]}>
            <Image
              src={post.data.image}
              alt={post.data.imageAlt ?? `Bit & Bullshit Maskottchen zum Snippet: ${post.data.title}`}
              widths={istQuer ? [480, 720, 1024, 1440] : [360, 540, 720]}
              sizes={istQuer ? "(min-width: 768px) 44rem, 92vw" : "(min-width: 768px) 28rem, 88vw"}
              class="block h-auto w-full"
              loading="eager"
            />
          </figure>
        )
      }

      <div class="post-body mt-10">
        <Content />
      </div>

      {/* Quellen stehen zwischen Text und Weiterlesen-Panel: Wer den Beleg
          sucht, findet ihn direkt am Textende — und nicht erst hinter dem
          Verweis auf eine andere Seite. */}
      {
        post.data.quellen && post.data.quellen.length > 0 && (
          <aside class="mt-12 border-t border-white/10 pt-6" data-pagefind-ignore>
            <p class="display text-xs tracking-[0.3em] text-orange">// QUELLEN</p>
            <ul class="mt-4 space-y-2.5 text-sm leading-relaxed text-paper/70">
              {post.data.quellen.map((q) => (
                <li>
                  {q.url ? (
                    <a
                      href={q.url}
                      rel="noopener"
                      class="drip-underline text-paper/85 hover:text-orange"
                    >
                      {q.text}
                    </a>
                  ) : (
                    q.text
                  )}
                </li>
              ))}
            </ul>
          </aside>
        )
      }

      {
        post.data.aeraLink && (
          <div class="mt-12 rounded-2xl border border-white/10 bg-white/[0.03] p-6" data-pagefind-ignore>
            <p class="display text-xs tracking-[0.3em] text-orange">// TIEFER EINSTEIGEN</p>
            <p class="mt-3 text-base text-paper/90">
              Ausführliche Erklärung mit Beispielen und Quellen:
              {" "}
              <a href={post.data.aeraLink} rel="noopener" class="drip-underline text-paper hover:text-orange">
                auf bitcoinaera.de weiterlesen &rarr;
              </a>
            </p>
          </div>
        )
      }

      <VerwandteArtikel aktuell={post.id} />

      <div class="mt-16 border-t border-white/10 pt-10" data-pagefind-ignore>
        <p class="display text-2xl md:text-3xl">
          Gefällt&apos;s dir? <span class="text-orange">Folg uns.</span>
        </p>
        <p class="mt-3 text-sm text-paper/70">
          Neue Snippets zuerst auf TikTok und Instagram. @bitandbullshit auf beiden.
        </p>
        <div class="mt-6">
          <SocialLinks />
        </div>
      </div>

      <p class="mt-10 text-xs leading-relaxed text-paper/50" data-pagefind-ignore>
        Nur Meinung &amp; Unterhaltung. Keine Finanz-, Steuer- oder Rechtsberatung.
      </p>
    </article>
  </main>

  <SiteFooter />
</Layout>

<style>
  .langfassung-hinweis {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 2rem;
    padding: 1.25rem 1.35rem;
    border: 1px solid rgb(from var(--color-orange) r g b / 0.35);
    border-radius: 0.4rem;
    background: rgb(from var(--color-orange) r g b / 0.05);
    transition: border-color 200ms ease;
  }
  .langfassung-hinweis:hover {
    border-color: var(--color-orange);
  }
  .langfassung-kicker {
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    color: var(--color-orange);
  }
  .langfassung-text {
    line-height: 1.6;
    color: rgb(from var(--color-paper) r g b / 0.85);
  }
  .langfassung-link {
    margin-top: 0.35rem;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--color-orange);
  }
</style>

