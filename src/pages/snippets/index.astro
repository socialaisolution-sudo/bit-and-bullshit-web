---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { getCollection } from "astro:content";
import { KATEGORIEN } from "../../data/kategorien";

const posts = await getCollection("blog");
posts.sort((a, b) => a.data.order - b.data.order);

/* Die Rubriken kommen aus src/data/kategorien.ts, damit Übersicht,
   Kategorie-Seite und Artikel-Kicker nie auseinanderlaufen. */
const groups = KATEGORIEN;

---

<Layout
  title="Snippets — Bit & Bullshit"
  description="Bitcoin, Makro, Geld — Kurz-Artikel im Bit-&-Bullshit-Ton. Von Fiatgeld über Cantillon-Effekt bis Chatkontrolle."
>
  <SiteHeader />

  <main class="relative mx-auto max-w-6xl overflow-hidden px-5 py-16 md:py-24">
    <header class="relative max-w-3xl">
      <span class="wall-ghost" aria-hidden="true">SNIPPETS</span>
      <p class="display hero-layer text-xs tracking-[0.3em] text-orange">// SNIPPETS</p>
      <h1 class="display spray-head hero-layer mt-4 text-4xl md:text-6xl">
        Snippets zum <span class="marker">Nachlesen.</span>
      </h1>
      <p class="hero-layer mt-8 text-lg leading-relaxed text-paper/80">
        Jedes Video ist auch ein Kurz-Artikel. Falls du lieber liest, scrollen
        statt scrollen kannst oder das Skript nochmal in Ruhe brauchst.
      </p>
    </header>

    <div class="mt-14 space-y-16">
      {
        groups.map((group, gi) => {
          const items = posts.filter((p) => p.data.kategorie === group.key);
          if (items.length === 0) return null;
          return (
            <section>
              <div class="mb-8">
                <p class="display text-xs tracking-[0.3em] text-orange">{group.kicker}</p>
                <header class="wall-head mt-3">
                  <span class="stencil-num wall-head-num" aria-hidden="true">
                    {String(gi + 1).padStart(2, "0")}
                  </span>
                  <h2 class="display wall-h">{group.titel}</h2>
                </header>
                <div class="spray-rule mt-4 max-w-[14rem]" />
                <p class="mt-5 max-w-2xl text-sm text-paper/70">{group.lede}</p>
              </div>
              <ul class="post-grid grid gap-5 md:grid-cols-2 md:gap-6">
                {items.map((post) => (
                  <li>
                    <a
                      href={`/snippets/${post.id}`}
                      class:list={[
                        "post-card group block h-full rounded-md border border-white/10 bg-ink/60 p-6 transition",
                        group.toneClass,
                      ]}
                    >
                      <p class="post-card-kicker display text-xs tracking-widest">
                        #{String(post.data.order).padStart(2, "0")}
                        {post.data.draft && (
                          <span class="ml-2 rounded-sm bg-orange/20 px-1.5 py-0.5 text-[0.65rem] text-orange">
                            Entwurf
                          </span>
                        )}
                      </p>
                      <h3 class="post-card-title display mt-2 text-lg leading-tight text-paper transition md:text-xl">
                        {post.data.title}
                      </h3>
                      <p class="mt-3 text-sm leading-relaxed text-paper/70">
                        {post.data.description}
                      </p>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          );
        })
      }
    </div>
  </main>

  <SiteFooter />
</Layout>

<style>
  .post-card {
    position: relative;
    border-left-width: 3px;
    padding-left: calc(1.5rem - 3px + 3px);
    transition:
      transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 220ms ease,
      box-shadow 220ms ease;
    will-change: transform;
  }
  .post-card-kicker { color: rgba(245, 244, 239, 0.4); }

  /* Leichte Schieflage bricht das Raster auf, ohne die Scanbarkeit zu
     kosten — bewusst deutlich schwächer als auf der Sticker-Wall, weil
     hier über 30 Karten untereinander stehen. */
  .post-grid > li:nth-child(4n + 1) .post-card { transform: rotate(-0.5deg); }
  .post-grid > li:nth-child(4n + 2) .post-card { transform: rotate(0.4deg); }
  .post-grid > li:nth-child(4n + 3) .post-card { transform: rotate(0.55deg); }
  .post-grid > li:nth-child(4n + 4) .post-card { transform: rotate(-0.35deg); }

  .post-card:hover,
  .post-card:focus-visible {
    transform: rotate(0deg) translateY(-4px);
    box-shadow: 0 18px 32px -14px rgba(0, 0, 0, 0.7);
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-grid > li .post-card,
    .post-card:hover,
    .post-card:focus-visible {
      transform: none;
      transition: none;
    }
  }

  /* Entlarven — Marken-Orange */
  .post-card.cat-entlarven { border-left-color: rgba(247, 147, 26, 0.55); }
  .post-card.cat-entlarven .post-card-kicker { color: #f7931a; }
  .post-card.cat-entlarven:hover { border-color: rgba(247, 147, 26, 0.9); }
  .post-card.cat-entlarven:hover .post-card-title { color: #f7931a; }

  /* Learning — kühl, um sich von Entlarven abzuheben */
  .post-card.cat-learning { border-left-color: rgba(180, 200, 230, 0.55); }
  .post-card.cat-learning .post-card-kicker { color: #b4c8e6; }
  .post-card.cat-learning:hover { border-color: rgba(180, 200, 230, 0.9); }
  .post-card.cat-learning:hover .post-card-title { color: #b4c8e6; }

  /* Denkfehler — Orange-Deep für die Serie */
  .post-card.cat-denkfehler { border-left-color: rgba(196, 111, 0, 0.7); }
  .post-card.cat-denkfehler .post-card-kicker { color: #e6a24a; }
  .post-card.cat-denkfehler:hover { border-color: rgba(196, 111, 0, 1); }
  .post-card.cat-denkfehler:hover .post-card-title { color: #e6a24a; }
</style>
