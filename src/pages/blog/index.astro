---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
posts.sort((a, b) => a.data.order - b.data.order);

const groups = [
  {
    key: "entlarven" as const,
    kicker: "// ENTLARVEN",
    title: "Entlarven & Mechanik",
    lede: "Wie das Geldsystem, der Staat und die Krypto-Bühne wirklich funktionieren — und wo der Bullshit anfängt.",
    toneClass: "cat-entlarven",
  },
  {
    key: "learning" as const,
    kicker: "// LEARNING",
    title: "Bitcoin verstehen",
    lede: "Die Grundlagen. Kurz erklärt. Tieferer Kaninchenbau auf bitcoinaera.de.",
    toneClass: "cat-learning",
  },
  {
    key: "denkfehler" as const,
    kicker: "// SERIE",
    title: "Der große Bitcoin-Denkfehler",
    lede: "Die Serie über die Fragen, die fast alle Bitcoin-Kritiker stellen — und die Antworten, die selten kommen.",
    toneClass: "cat-denkfehler",
  },
];
---

<Layout
  title="Blog — Bit & Bullshit"
  description="Bitcoin, Makro, Geld — Kurz-Artikel im Bit-&-Bullshit-Ton. Von Fiatgeld über Cantillon-Effekt bis Chatkontrolle."
>
  <SiteHeader />

  <main class="mx-auto max-w-6xl px-5 py-16 md:py-24">
    <header class="max-w-3xl">
      <p class="display text-xs tracking-[0.3em] text-orange">// BLOG</p>
      <h1 class="display mt-4 text-4xl md:text-6xl">
        Snippets zum <span class="drip-underline">Nachlesen.</span>
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-paper/80">
        Jedes Video ist auch ein Kurz-Artikel. Falls du lieber liest, scrollen
        statt scrollen kannst oder das Skript nochmal in Ruhe brauchst.
      </p>
    </header>

    <div class="mt-16 space-y-20">
      {
        groups.map((group) => {
          const items = posts.filter((p) => p.data.category === group.key);
          if (items.length === 0) return null;
          return (
            <section>
              <div class="mb-8 border-b border-white/10 pb-4">
                <p class="display text-xs tracking-[0.3em] text-orange">{group.kicker}</p>
                <h2 class="display mt-3 text-2xl md:text-4xl">{group.title}</h2>
                <p class="mt-3 max-w-2xl text-sm text-paper/70">{group.lede}</p>
              </div>
              <ul class="grid gap-4 md:grid-cols-2">
                {items.map((post) => (
                  <li>
                    <a
                      href={`/${post.id}`}
                      class:list={[
                        "post-card group block h-full rounded-2xl border border-white/10 bg-ink/60 p-6 transition",
                        group.toneClass,
                      ]}
                    >
                      <p class="post-card-kicker display text-xs tracking-widest">
                        #{String(post.data.order).padStart(2, "0")}
                        {post.data.draft && (
                          <span class="ml-2 rounded-sm bg-orange/20 px-1.5 py-0.5 text-[0.65rem] text-orange">
                            Entwurf
                          </span>
                        )}
                      </p>
                      <h3 class="post-card-title display mt-2 text-lg leading-tight text-paper transition md:text-xl">
                        {post.data.title}
                      </h3>
                      <p class="mt-3 text-sm leading-relaxed text-paper/70">
                        {post.data.description}
                      </p>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          );
        })
      }
    </div>
  </main>

  <SiteFooter />
</Layout>

<style>
  .post-card {
    position: relative;
    border-left-width: 3px;
    padding-left: calc(1.5rem - 3px + 3px);
  }
  .post-card-kicker { color: rgba(245, 244, 239, 0.4); }

  /* Entlarven — Marken-Orange */
  .post-card.cat-entlarven { border-left-color: rgba(247, 147, 26, 0.55); }
  .post-card.cat-entlarven .post-card-kicker { color: #f7931a; }
  .post-card.cat-entlarven:hover { border-color: rgba(247, 147, 26, 0.9); }
  .post-card.cat-entlarven:hover .post-card-title { color: #f7931a; }

  /* Learning — kühl, um sich von Entlarven abzuheben */
  .post-card.cat-learning { border-left-color: rgba(180, 200, 230, 0.55); }
  .post-card.cat-learning .post-card-kicker { color: #b4c8e6; }
  .post-card.cat-learning:hover { border-color: rgba(180, 200, 230, 0.9); }
  .post-card.cat-learning:hover .post-card-title { color: #b4c8e6; }

  /* Denkfehler — Orange-Deep für die Serie */
  .post-card.cat-denkfehler { border-left-color: rgba(196, 111, 0, 0.7); }
  .post-card.cat-denkfehler .post-card-kicker { color: #e6a24a; }
  .post-card.cat-denkfehler:hover { border-color: rgba(196, 111, 0, 1); }
  .post-card.cat-denkfehler:hover .post-card-title { color: #e6a24a; }
</style>
