---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ReportBloecke from "../../components/ReportBloecke.astro";
import KennzahlDefinitionen from "../../components/KennzahlDefinitionen.astro";
import { aktuellerReport, wochenLabel, oeffentlichAb } from "../../lib/leserbereich";
import { letzterVersand } from "../../lib/ausgaben";
import { Image } from "astro:assets";
import pete from "../../assets/pete-kopf.webp";
import { COMIC_NEUESTE } from "../../data/comics";

const report = await aktuellerReport();
/* Bezugspunkt fuer "Bewegung seit der letzten Ausgabe". Gibt es noch
   keine verschickte Ausgabe, bleibt die Zeile weg. */
const seitVersand = await letzterVersand();
const datumLang = (d: Date) =>
  new Intl.DateTimeFormat("de-DE", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }).format(d);

/**
 * Der Leserbereich.
 *
 * Diese Seite wird nur ausgeliefert, wenn die Zwischenschicht in
 * functions/leserbereich/_middleware.ts das Cookie durchgelassen hat.
 * Ohne gültiges Cookie sieht niemand dieses Markup — die Anmeldeseite
 * kommt aus der Zwischenschicht selbst, mit HTTP 401.
 *
 * Was hier liegt und was nicht, folgt einer Linie: „Wie funktioniert
 * das" bleibt öffentlich, weil es dauerhaft nachschlagbar ist und
 * ranken soll. „Wie steht es gerade und was heißt das" liegt hier.
 * Gesperrtes rankt nicht — deshalb darf nichts Evergreenes hier
 * hinein.
 */
---

<Layout
  title="Leserbereich — Bit & Bullshit"
  description="Die ausführliche Auswertung zur Bitcoin-Ampel."
  noindex
>
  <SiteHeader />

  <main class="mx-auto max-w-4xl px-5 py-14 md:py-20">
    <div class="lb-kopf">
      <Image src={pete} alt="Pete, das Maskottchen von Bit & Bullshit" width={88} height={88} class="lb-pete" loading="eager" />
      <div>
        <p class="lb-kicker">// Leserbereich</p>
        <h1 class="display spray-head lb-h1">Die ausführliche Auswertung</h1>
      </div>
    </div>
    <p class="mt-4 max-w-2xl opacity-80">
      Der Stand jetzt, was er für die Positionierung heißt, und einmal in der
      Woche ein Blick auf das größere Bild. Die Freitagsausgabe ist
      eingefroren — hier läuft es weiter.
    </p>
    {
      report && (
        <p class="lb-woche">
          Report {wochenLabel(report.data.kw)} &middot; wird am{" "}
          {datumLang(oeffentlichAb(report.data.kw))} öffentlich
        </p>
      )
    }

    <section class="wall-sec lb-ghost-sec" data-tiefe>
      <span class="wall-ghost" aria-hidden="true">JETZT</span>
      <header class="wall-head">
        <span class="stencil-num wall-head-num" aria-hidden="true">01</span>
        <h2 class="display wall-h">Stand jetzt</h2>
      </header>
      <div class="spray-rule mt-4 max-w-[12rem]"></div>
      <p class="lb-laden" data-laden>Wird geladen …</p>
      {seitVersand && <span hidden data-seit={seitVersand} />}
      <div class="lb-inhalt" data-inhalt hidden></div>
    </section>

    {report && <ReportBloecke report={report} ab={2} />}
    {
      !report && (
        <section class="wall-sec">
          <p class="lb-hinweis">
            Für diese Woche liegt noch kein Report vor. Der Stand oben ist
            trotzdem aktuell.
          </p>
        </section>
      )
    }

    <KennzahlDefinitionen nr="05" />

    {/* Ein Comic-Panel als Zaesur zwischen Report und Seitenteil.
        Eine Textseite braucht eine Stelle, an der das Auge ausruht —
        und das juengste Kapitel steht sonst nur auf der Startseite.
        Inhalt kommt aus data/comics.ts, ein neues Kapitel laesst hier
        nichts zu tun uebrig. */}
    <a href={`/comic/${COMIC_NEUESTE.slug}/`} class="lb-comic">
      <Image
        src={COMIC_NEUESTE.cover}
        alt={COMIC_NEUESTE.coverAlt}
        widths={[480, 720, 1024]}
        sizes="(min-width: 900px) 46rem, 92vw"
        class="lb-comic-bild"
        loading="lazy"
      />
      <div class="lb-comic-text">
        <p class="lb-kicker">// Comic &middot; Teil {COMIC_NEUESTE.teil}</p>
        <p class="display lb-comic-h">{COMIC_NEUESTE.titel}</p>
        <p class="lb-comic-anriss">{COMIC_NEUESTE.anriss}</p>
      </div>
    </a>

    {/* Ab hier nicht mehr der Report, sondern die Seite: Bilanz und
        Abgrenzung gehoeren nicht in Dennys Fuenferfolge und tragen
        deshalb keine Nummer. */}
    <hr class="lb-schnitt" />

    <section class="wall-sec">
      <p class="lb-kicker">// Trefferbilanz</p>
      <h2 class="display lb-h2">Trifft die Ampel, was sie soll?</h2>
      </header>
      <p class="lb-hinweis">
        Wie oft die Ampel welche Farbe gezeigt hat, gegen das, was die
        Kalibrierung erwarten ließ. Diese Zahlen stehen auch
        <a href="https://bitcoinaera.de/ampel/regeln/" rel="noopener">öffentlich</a> —
        wer ein Ampelsystem betreibt und seine Trefferquote versteckt, ist Teil
        des Problems.
      </p>
      <div class="lb-inhalt" data-bilanz hidden></div>
    </section>

    <section class="wall-sec">
      <p class="lb-kicker">// Was hier nicht liegt</p>
      <h2 class="display lb-h2">Was öffentlich bleibt</h2>
      <p class="lb-hinweis">
        Das Regelwerk, die Erklärungen zu jeder Kennzahl und die aktuelle
        Ampelfarbe sind öffentlich und bleiben es. Hinter dem Passwort liegt
        nur, was tagesaktuell ist — Nachschlagbares gehört dorthin, wo man es
        findet.
      </p>
      <ul class="lb-links">
        <li><a href="https://bitcoinaera.de/ampel/" rel="noopener">Die Ampel</a></li>
        <li><a href="https://bitcoinaera.de/ampel/regeln/" rel="noopener">Das vollständige Regelwerk</a></li>
        <li><a href="https://bitcoinaera.de/glossar/funding-rate/" rel="noopener">Funding Rate</a></li>
        <li><a href="https://bitcoinaera.de/glossar/open-interest/" rel="noopener">Open Interest</a></li>
        <li><a href="https://bitcoinaera.de/glossar/coinbase-premium/" rel="noopener">Coinbase-Premium</a></li>
        <li><a href="https://bitcoinaera.de/glossar/etf-nettofluesse/" rel="noopener">ETF-Nettoflüsse</a></li>
        <li><a href="https://bitcoinaera.de/glossar/stablecoin-versorgung/" rel="noopener">Stablecoin-Versorgung</a></li>
      </ul>
    </section>

    <p class="lb-fuss">
      Kein Konto, keine gespeicherten Daten — nur ein Cookie mit der laufenden
      Kalenderwoche. <a href="/api/leserbereich?abmelden=1">Abmelden</a> ·
      <a href="/datenschutz/">Datenschutz</a> · <a href="/leserreports/">Ältere Reports</a> ·
      Neues Passwort jeden Freitag im
      <a href="/bullshitmelder/">Bullshitmelder</a>
    </p>
  </main>

  <SiteFooter />
</Layout>

<script>
  const QUELLE = "https://bitcoin-ampel.social-ai-solution.workers.dev";

  /**
   * „Bewegung seit der letzten Ausgabe".
   *
   * Verglichen wird Stufe gegen Stufe, nicht Wert gegen Wert: Die
   * Ampel entscheidet nach Stufen, und ein Wert, der sich bewegt hat
   * ohne die Stufe zu wechseln, hat fuer die Farbe nichts geaendert.
   *
   * Hat sich nichts bewegt, steht das auch da. „Unveraendert" ist
   * eine Aussage, eine leere Zeile ist keine.
   */
  function bewegung(jetzt: any, vorher: any, seit?: string): string {
    if (!vorher || !seit) return "";

    /* Liegt das Versanddatum noch in der Zukunft — die Ausgabe ist
       fertig, aber noch nicht raus —, vergleicht der Endpunkt den
       jetzigen Stand mit sich selbst und meldete "unveraendert". Das
       klingt nach einer Aussage und ist keine. Dann lieber nichts. */
    const heute = new Date().toISOString().slice(0, 10);
    if (seit >= heute) return "";
    const NAMEN: Record<string, string> = NAME;
    const teile: string[] = [];

    if (vorher.ampel && jetzt.ampel && vorher.ampel !== jetzt.ampel) {
      teile.push(`die Ampel von <strong>${FARBE[vorher.ampel]}</strong> auf <strong>${FARBE[jetzt.ampel]}</strong>`);
    }
    for (const [k, e] of Object.entries<any>(jetzt.eingaenge ?? {})) {
      const v = vorher.eingaenge?.[k];
      if (!v) continue;
      const vs = v.verfuegbar ? v.stufe : null;
      const js = e.verfuegbar ? e.stufe : null;
      if (vs === js) continue;
      const von = vs ? (STUFE[vs] ?? vs) : "ohne Wert";
      const nach = js ? (STUFE[js] ?? js) : "ohne Wert";
      teile.push(`${NAMEN[k] ?? k} von <em>${von}</em> auf <em>${nach}</em>`);
    }

    const datum = new Date(seit + "T00:00:00Z").toLocaleDateString("de-DE", {
      day: "numeric", month: "long", timeZone: "UTC",
    });
    if (!teile.length) {
      return `<p class="lb-bewegung">Seit der Ausgabe vom ${datum} unverändert.</p>`;
    }
    return `<p class="lb-bewegung"><strong>Seit der Ausgabe vom ${datum}:</strong> ${teile.join(", ")}.</p>`;
  }
  const FARBE: Record<string, string> = { gruen: "Grün", gelb: "Gelb", rot: "Rot" };
  const STUFE: Record<string, string> = {
    ruhig: "ruhig",
    erhoeht: "erhöht",
    extrem: "im Extrem",
  };
  const NAME: Record<string, string> = {
    etf: "ETF-Nettoflüsse",
    premium: "Coinbase-Premium",
    stablecoins: "Stablecoin-Versorgung",
    open_interest: "Open Interest",
  };

  const laden = document.querySelector<HTMLElement>("[data-laden]");
  const inhalt = document.querySelector<HTMLElement>("[data-inhalt]");
  const bilanz = document.querySelector<HTMLElement>("[data-bilanz]");

  try {
    const [a, b] = await Promise.all([
      fetch(`${QUELLE}/ampel`).then((r) => r.json()),
      fetch(`${QUELLE}/bilanz`).then((r) => r.json()),
    ]);

    /* Der Stand zum Tag der letzten Ausgabe. Faellt der Abruf aus
       oder gibt es noch keine Ausgabe, entfaellt nur die
       Bewegungszeile — der Rest steht trotzdem. */
    let vorher: any = null;
    const seit = document.querySelector<HTMLElement>("[data-seit]")?.dataset.seit;
    if (seit) {
      try {
        const v = await fetch(`${QUELLE}/verlauf?seit=${seit}`).then((r) => r.json());
        if (v?.gefunden) vorher = v;
      } catch {
        /* still */
      }
    }

    if (inhalt && a?.ampel) {
      const zeilen = Object.entries(a.eingaenge ?? {})
        .map(([k, e]: [string, any]) => {
          const stufe = e.verfuegbar ? (STUFE[e.stufe] ?? e.stufe) : `— ${e.grund ?? "kein Wert"}`;
          return `<tr><td>${NAME[k] ?? k}</td><td class="lb-stufe" data-wert="${e.verfuegbar ? e.stufe : "fehlt"}">${stufe}</td></tr>`;
        })
        .join("");
      const fr = a.funding_regime;
      inhalt.innerHTML =
        `<p class="lb-farbe" data-wert="${a.ampel}">${FARBE[a.ampel] ?? a.ampel}` +
        `<span class="lb-grund">${a.ampel_grund ?? ""}</span></p>` +
        `<table class="lb-tabelle"><tbody>${zeilen}</tbody></table>` +
        (fr?.tage_seither != null
          ? `<p class="lb-funding"><strong>${fr.tage_seither} Tage</strong> ohne positiven Funding-Überschuss ` +
            `(zuletzt ${fr.letzter_ueberschuss}). Die Kennzahl zählt derzeit nicht in die Farbe hinein.</p>`
          : "") +
        bewegung(a, vorher, seit) +
        `<p class="lb-klein">Regelversion ${a.regelversion ?? "—"} · vor ${Math.round((a.alter_sekunden ?? 0) / 60)} Minuten gemessen` +
        (a.quellenangabe?.etf ? ` · ETF-Daten: ${a.quellenangabe.etf}` : "") +
        `</p>`;
      inhalt.hidden = false;
      if (laden) laden.hidden = true;
    } else if (laden) {
      laden.textContent = "Zurzeit liegt keine belastbare Messung vor.";
    }

    if (bilanz && b) {
      const anteil = b.anteil_prozent ?? {};
      const gelbErw = b.erwartet?.gelb_prozent ?? 0;
      const rotErw = b.erwartet?.rot_prozent ?? 0;

      /* Rot ist eine TEILMENGE von Gelb — das Regelwerk sagt "Rot
         erzwingt Gelb". Die erwarteten 14,3 % Gelb enthalten also die
         2,7 % Rot. Angezeigt werden aber exklusive Farben, weil die
         Ampel immer genau eine zeigt. Wer die drei Erwartungswerte
         einfach nebeneinanderstellt, zeigt 117 % und eine falsche
         Aussage. */
      const erwartet: Record<string, number> = {
        gruen: Math.max(0, 100 - gelbErw),
        gelb: Math.max(0, gelbErw - rotErw),
        rot: rotErw,
      };

      const balken = ["gruen", "gelb", "rot"]
        .map((f) => {
          const ist = anteil[f] ?? 0;
          const soll = erwartet[f];
          return (
            `<div class="bi-zeile" data-wert="${f}">` +
            `<p class="bi-name">${FARBE[f]}</p>` +
            `<div class="bi-bahn">` +
            `<div class="bi-balken" style="width:${Math.max(ist, 0.4)}%"></div>` +
            `<span class="bi-soll" style="left:${soll}%" title="erwartet ${soll.toFixed(1)} %"></span>` +
            `</div>` +
            `<p class="bi-zahl"><strong>${ist.toFixed(1)} %</strong>` +
            `<span class="bi-erw">erwartet ${soll.toFixed(1)} %</span></p>` +
            `</div>`
          );
        })
        .join("");

      /* Die eine Zahl, die der Leser wirklich mitnehmen soll. */
      const gelbIst = anteil.gelb ?? 0;
      const fazit =
        gelbIst === 0 && (anteil.rot ?? 0) === 0
          ? `Die Ampel stand in ${b.vollstaendige_laeufe ?? 0} vollständigen Läufen <strong>kein einziges Mal</strong> auf Gelb oder Rot. Erwartet waren ${gelbErw.toFixed(1)} %. Entweder war der Markt die ganze Zeit ruhig, oder die Schwellen sitzen zu hoch — nach so kurzer Laufzeit weiß das niemand.`
          : `Gemessen an ${b.vollstaendige_laeufe ?? 0} vollständigen Läufen.`;

      bilanz.innerHTML =
        `<div class="bi-grid">${balken}</div>` +
        `<p class="bi-fazit">${fazit}</p>` +
        `<p class="lb-klein">Verglichen wird nur, was mit allen vier Eingängen gerechnet wurde. ` +
        `Neu gerechnet wird spätestens am ${b.neu_rechnen_ab ?? "—"}. ` +
        `Der Strich in der Bahn markiert den Erwartungswert aus der Kalibrierung.</p>`;
      bilanz.hidden = false;
    }

  } catch {
    if (laden) laden.textContent = "Die Auswertung ist gerade nicht erreichbar.";
  }
</script>

<style>
  /* Ohne Abstand stossen lange Beschriftungen auf schmalen Schirmen
     an den Wert — „Stablecoin-Versorgungruhig“. Der Wert bricht nicht
     um, die Beschriftung darf. */
  .lb-links { margin: 1rem 0 0; padding-left: 1.1rem; font-size: 0.95rem; }
  .lb-links li { margin: 0.3rem 0; }
  /* Trennt den Report von der Seite darunter. */
  .lb-ghost-sec { position: relative; overflow: hidden; }
  .lb-ghost-sec > .wall-ghost { top: 1.5rem; right: -1rem; font-size: clamp(3rem, 12vw, 7rem); }
  .lb-ghost-sec > *:not(.wall-ghost) { position: relative; }

  /* Das Panel laeuft breiter als der Lesetext — es ist die Pause,
     nicht die Fortsetzung. */
  .lb-comic {
    display: block;
    margin: 4rem 0 0;
    text-decoration: none;
    color: inherit;
    border: 1px solid rgb(from var(--color-paper) r g b / 0.12);
    border-radius: 0.4rem;
    overflow: hidden;
    transform: rotate(-0.5deg);
    transition: transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .lb-comic:hover { transform: rotate(0deg) translateY(-3px); }
  .lb-comic-bild { display: block; width: 100%; height: auto; }
  .lb-comic-text { padding: 1.1rem 1.25rem 1.3rem; }
  .lb-comic-h { font-size: clamp(1.1rem, 3.5vw, 1.5rem); line-height: 1.2; margin: 0.45rem 0 0; }
  .lb-comic-anriss { margin: 0.5rem 0 0; font-size: 0.9rem; line-height: 1.6; opacity: 0.7; max-width: 36rem; }

  @media (prefers-reduced-motion: reduce) {
    .lb-comic, .lb-comic:hover { transform: none; transition: none; }
  }

  .lb-schnitt {
    border: 0;
    border-top: 1px solid rgb(from var(--color-paper) r g b / 0.14);
    margin: 3.5rem 0 0;
  }
  .lb-h2 { font-size: clamp(1.2rem, 3.5vw, 1.6rem); line-height: 1.2; margin: 0.6rem 0 0; }
  .lb-kopf {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }
  .lb-pete {
    flex: none;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 0.5rem;
    transform: rotate(-2deg);
  }
  @media (min-width: 768px) {
    .lb-pete { width: 5.5rem; height: 5.5rem; }
  }
  .lb-h1 { font-size: clamp(1.6rem, 5.5vw, 2.6rem); line-height: 1.05; margin-top: 0.3rem; }
  .lb-woche {
    margin: 1.25rem 0 0;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    opacity: 0.55;
  }
  .lb-fuss { margin: 3rem 0 0; font-size: 0.8rem; opacity: 0.55; }
</style>
