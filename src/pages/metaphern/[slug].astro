---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Brotkrumen from "../../components/Brotkrumen.astro";
import Inhaltsverzeichnis from "../../components/Inhaltsverzeichnis.astro";
import { getCollection, render } from "astro:content";
import { Image, getImage } from "astro:assets";
import type { GetStaticPaths } from "astro";
import { COMICS } from "../../data/comics";

/**
 * Ein Eintrag im Metaphern-Register.
 *
 * Aufbau wie bei den Cornerstones, nur ruhiger: Das Register ist
 * Nachschlagewerk, kein Take. Deshalb kein Folg-uns-Block und kein
 * Weiterlesen-Panel — nur der Rückweg in die Artikel, in denen das Bild
 * angewendet wird, und gegebenenfalls der Comic.
 *
 * Entwürfe werden gebaut, aber nicht ausgeliefert: `draft` haelt sie aus
 * getStaticPaths heraus.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const eintraege = await getCollection("metaphern", ({ data }) => data.draft !== true);
  return eintraege.map((eintrag) => ({
    params: { slug: eintrag.id },
    props: { eintrag },
  }));
};

const { eintrag } = Astro.props;
const { Content, headings } = await render(eintrag);
const d = eintrag.data;

const comic = d.comic ? COMICS.find((c) => `/comic/${c.slug}/` === d.comic) : undefined;

const site = Astro.site ?? new URL("https://bitandbullshit.com");
let ogImagePath: string | undefined;
if (d.image) {
  const optimiert = await getImage({ src: d.image, width: 1200, format: "jpg" });
  ogImagePath = optimiert.src;
}

const seitenTitel = d.metaTitel ?? `${d.title} — Metaphern | Bit & Bullshit`;

/* DefinedTerm statt Article: Der Eintrag beschreibt ein Denkbild, er
   berichtet nichts. Das Register ist der Begriffssatz drumherum. */
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  name: d.title,
  description: d.kurz,
  inLanguage: "de-DE",
  url: new URL(`/metaphern/${eintrag.id}/`, site).toString(),
  inDefinedTermSet: {
    "@type": "DefinedTermSet",
    name: "Marktmetaphern",
    url: new URL("/metaphern/", site).toString(),
  },
};
---

<Layout
  title={seitenTitel}
  description={d.metaBeschreibung ?? d.description}
  ogImage={ogImagePath}
  ogType="article"
  jsonLd={jsonLd}
>
  <SiteHeader />

  <div class="mp-raster px-5 py-12 md:py-16">
    <Inhaltsverzeichnis headings={headings} />

    <main class="mp-spalte">
      <Brotkrumen
        pfad={[
          { label: "Start", href: "/" },
          { label: "Metaphern", href: "/metaphern/" },
          { label: d.title },
        ]}
      />

      <article class="mt-8" data-pagefind-body data-pagefind-meta="category:Metaphern">
        <p class="display text-xs tracking-[0.3em] text-orange" data-pagefind-ignore>
          // Denkbild
        </p>
        <h1 class="post-h1 display mt-4 text-3xl md:text-5xl">{d.title}</h1>
        <p class="mp-kurz mt-5">{d.kurz}</p>

        {
          d.image && (
            <figure class="post-hero-image ist-quer mt-10">
              <Image
                src={d.image}
                alt={d.imageAlt ?? d.title}
                widths={[480, 720, 1024, 1200]}
                sizes="(min-width: 768px) 44rem, 92vw"
                class="block h-auto w-full"
                loading="eager"
              />
            </figure>
          )
        }

        <div class="post-body mt-10">
          <Content />
        </div>

        {
          comic && (
            <a href={`/comic/${comic.slug}/`} class="mp-comic" data-pagefind-ignore>
              <Image
                src={comic.cover}
                alt=""
                widths={[240, 360]}
                sizes="7rem"
                class="mp-comic-cover"
                loading="lazy"
              />
              <span class="mp-comic-body">
                <span class="display mp-comic-kicker">// Auch als Comic</span>
                <span class="mp-comic-text">
                  Dieses Bild gibt&apos;s auch gezeichnet: „{comic.titel}“
                </span>
                <span class="display mp-comic-link">Comic ansehen &rarr;</span>
              </span>
            </a>
          )
        }

        {
          d.angewendet && d.angewendet.length > 0 && (
            <aside class="mt-12 border-t border-white/10 pt-6" data-pagefind-ignore>
              <p class="display text-xs tracking-[0.3em] text-orange">// IM EINSATZ</p>
              <p class="mt-3 text-sm text-paper/60">
                Wo dieses Bild angewendet wird:
              </p>
              <ul class="mt-4 space-y-2.5 text-sm leading-relaxed">
                {d.angewendet.map((a) => (
                  <li>
                    <a href={a.pfad} class="drip-underline text-paper/85 hover:text-orange">
                      {a.titel}
                    </a>
                  </li>
                ))}
              </ul>
            </aside>
          )
        }

        <p class="mt-12 text-xs leading-relaxed text-paper/50" data-pagefind-ignore>
          Nur Meinung &amp; Unterhaltung. Keine Finanz-, Steuer- oder
          Rechtsberatung.
        </p>
      </article>
    </main>
  </div>

  <SiteFooter />
</Layout>

<style>
  .mp-raster {
    max-width: 48rem;
    margin-inline: auto;
  }
  .mp-spalte {
    max-width: 48rem;
  }
  @media (min-width: 1280px) {
    .mp-raster {
      display: grid;
      grid-template-columns: 15rem minmax(0, 48rem) 1fr;
      gap: 3rem;
      max-width: 78rem;
    }
  }

  .mp-kurz {
    max-width: 44rem;
    font-size: 1.2rem;
    line-height: 1.6;
    color: rgb(from var(--color-paper) r g b / 0.8);
  }

  .mp-comic {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-top: 2.5rem;
    padding: 1.25rem 1.35rem;
    border: 1px solid rgb(from var(--color-orange) r g b / 0.35);
    border-radius: 0.4rem;
    background: rgb(from var(--color-orange) r g b / 0.05);
    text-decoration: none;
    transition: border-color 200ms ease;
  }
  .mp-comic:hover {
    border-color: var(--color-orange);
  }
  .mp-comic-cover {
    flex: none;
    width: 7rem;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .mp-comic-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .mp-comic-kicker {
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    color: var(--color-orange);
  }
  .mp-comic-text {
    line-height: 1.6;
    color: rgb(from var(--color-paper) r g b / 0.85);
  }
  .mp-comic-link {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--color-orange);
  }
</style>
