---
/**
 * Die Sammelkarten-Rubrik.
 *
 * Seitenkopf hier, Raster und Kartenansicht in der Komponente. Der Kopf stand
 * zunaechst mit in der Komponente — mit eigener Ueberschriftengroesse,
 * eigenem Hintergrund und eigener Schriftfarbe. Eingebaut in die Seite sah
 * das aus wie ein fremdes Stueck mit sichtbarer Kante. Jetzt traegt die Seite
 * denselben Kopf wie das Metaphern-Register, und die Komponente kuemmert sich
 * nur noch um die Karten.
 *
 * Kein eigenes Ziel-Keyword: Die Keyword-Wache im Build liest nur die
 * Markdown-Bestaende. Diese Seite bewirbt sich nicht um eine Suchanfrage,
 * sie ist das Ziel der QR-Codes auf den gedruckten Karten.
 */
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Brotkrumen from "../components/Brotkrumen.astro";
import Sammelkarten from "../components/Sammelkarten.astro";
---

<Layout
  title="Pete-Sammelkarten — alle 21 Karten | Bit & Bullshit"
  description="Einundzwanzig Pete-Sammelkarten, jede mit einem Prinzip gegen Finanz-Bullshit. Karte antippen, umdrehen, Story lesen. Nur als komplettes 21er-Set."
>
  <SiteHeader />

  {/* `overflow-hidden` gehört zum Kopf: die Wandschrift ragt mit -1.5rem
      über den rechten Rand hinaus und erzeugt sonst eine Querleiste. */}
  <main class="relative mx-auto max-w-6xl overflow-hidden px-5 py-16 md:py-24">
    <Brotkrumen pfad={[{ label: "Start", href: "/" }, { label: "Sammelkarten" }]} />

    <header class="relative mt-8 max-w-3xl">
      <span class="wall-ghost" aria-hidden="true">21/21</span>
      <p class="display hero-layer text-xs tracking-[0.3em] text-orange">// COLLECTORS</p>
      {/* Wortlaut aus dem Prototyp. Der Produktname gehört in die
          Überschrift — danach sucht jemand, nicht nach einer Umschreibung. */}
      <h1 class="display spray-head hero-layer mt-4 text-4xl md:text-6xl">
        Die Pete-<span class="marker">Sammelkarten.</span>
      </h1>
      <p class="hero-layer mt-8 text-lg leading-relaxed text-paper/80">
        Einundzwanzig Karten. Jede ein Prinzip, das dich vor Finanz-Bullshit
        schützt. Tipp eine Karte an, dreh sie um — und lies die Story dahinter.
      </p>
    </header>

    <Sammelkarten />
  </main>

  <SiteFooter />
</Layout>
