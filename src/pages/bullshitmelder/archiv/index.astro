---
import Layout from "../../../layouts/Layout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import Brotkrumen from "../../../components/Brotkrumen.astro";
import NewsletterForm from "../../../components/NewsletterForm.astro";
import { oeffentlicheAusgaben, gesperrteAusgaben, datumLang, slugVon } from "../../../lib/ausgaben";

/**
 * Das Archiv.
 *
 * Der Bullshitmelder wohnt auf der eigenen Domain, Brevo ist nur der
 * Transportweg. Jede Ausgabe bekommt hier eine eigene Adresse, sobald
 * ihre Sperrfrist abgelaufen ist.
 *
 * Solange noch keine öffentlich ist, steht das auch so da — statt
 * einer leeren Liste, die wie ein Fehler aussieht.
 */
const ausgaben = await oeffentlicheAusgaben();
const gesperrt = await gesperrteAusgaben();

const FARBE: Record<string, string> = { gruen: "Grün", gelb: "Gelb", rot: "Rot" };
---

<Layout
  title="Archiv — Bullshitmelder | Bit & Bullshit"
  description="Alle öffentlichen Ausgaben des Bullshitmelders zum Nachlesen. Die Inhalte erscheinen acht bis zwölf Wochen nach dem Versand."
>
  <SiteHeader />

  <main class="mx-auto max-w-3xl px-5 py-12 md:py-16">
    <Brotkrumen
      pfad={[
        { label: "Start", href: "/" },
        { label: "Bullshitmelder", href: "/bullshitmelder/" },
        { label: "Archiv" },
      ]}
    />

    <p class="display mt-8 text-xs tracking-[0.3em] text-orange">// Archiv</p>
    <h1 class="display mt-4 text-3xl md:text-5xl">Alle Ausgaben zum Nachlesen</h1>
    <p class="mt-5 max-w-2xl opacity-85">
      Was im Bullshitmelder stand, erscheint acht bis zwölf Wochen später auch
      hier. Wer wartet, verpasst nichts — er erfährt es später.
    </p>

    {
      ausgaben.length === 0 ? (
        <div class="leer">
          <p class="display leer-titel">Noch ist keine Ausgabe frei</p>
          <p>
            {gesperrt === 0
              ? "Es ist noch keine Ausgabe verschickt. Sobald die erste draußen ist, steht sie acht bis zwölf Wochen später hier."
              : gesperrt === 1
                ? "Eine Ausgabe ist verschickt, ihre Sperrfrist läuft noch. Sie erscheint hier, sobald sie abgelaufen ist."
                : `${gesperrt} Ausgaben sind verschickt, ihre Sperrfristen laufen noch. Sie erscheinen hier nach und nach.`}
          </p>
        </div>
      ) : (
        <ol class="liste">
          {ausgaben.map((e) => (
            <li>
              <a href={`/bullshitmelder/archiv/${slugVon(e)}/`}>
                <span class="nummer display">#{e.data.nummer}</span>
                <span class="haupt">
                  <span class="titel display">{e.data.titel}</span>
                  <span class="anriss">{e.data.anriss}</span>
                  <span class="meta">
                    {datumLang(e.data.datum)}
                    {e.data.ampel.farbe && (
                      <> · Ampel {FARBE[e.data.ampel.farbe] ?? e.data.ampel.farbe}</>
                    )}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      )
    }

    {
      ausgaben.length > 0 && gesperrt > 0 && (
        <p class="gesperrt-hinweis">
          {gesperrt === 1
            ? "Eine weitere Ausgabe ist verschickt und wartet noch auf das Ende ihrer Sperrfrist."
            : `${gesperrt} weitere Ausgaben sind verschickt und warten noch auf das Ende ihrer Sperrfrist.`}
        </p>
      )
    }

    <div class="mt-14">
      <NewsletterForm variante="artikel-ende" quelle="archiv" />
    </div>
  </main>

  <SiteFooter />
</Layout>

<style>
  .leer {
    border: 1px solid rgba(255, 255, 255, 0.14);
    padding: 1.6rem;
    margin: 2.5rem 0 0;
  }
  .leer-titel { margin: 0 0 0.6rem; font-size: 1.3rem; }
  .leer p { margin: 0; opacity: 0.75; font-size: 0.97rem; }

  .liste { list-style: none; margin: 2.5rem 0 0; padding: 0; }
  .liste li { border-top: 1px solid rgba(255, 255, 255, 0.14); }
  .liste li:last-child { border-bottom: 1px solid rgba(255, 255, 255, 0.14); }
  .liste a {
    display: flex;
    gap: 1.2rem;
    padding: 1.3rem 0;
    text-decoration: none;
    color: inherit;
  }
  .liste a:hover .titel { color: var(--color-orange, #f7931a); }
  .nummer { flex: none; width: 3.2rem; font-size: 1.1rem; opacity: 0.4; }
  .haupt { display: flex; flex-direction: column; gap: 0.35rem; }
  .titel { font-size: 1.2rem; line-height: 1.25; }
  .anriss { font-size: 0.93rem; opacity: 0.75; }
  .meta { font-size: 0.78rem; opacity: 0.5; }

  .gesperrt-hinweis { margin-top: 1.6rem; font-size: 0.85rem; opacity: 0.55; }

  @media (max-width: 34rem) {
    .liste a { gap: 0.9rem; }
    .nummer { width: 2.4rem; font-size: 0.95rem; }
  }
</style>
