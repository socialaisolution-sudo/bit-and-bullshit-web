---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import Brotkrumen from "../../components/Brotkrumen.astro";
import AmpelHero from "../../components/AmpelHero.astro";
import FundingZaehler from "../../components/FundingZaehler.astro";
import JahresBalken from "../../components/JahresBalken.astro";
import AusgabeStapel from "../../components/AusgabeStapel.astro";
import { Image } from "astro:assets";
import maskottchen from "../../assets/mascot-hero.webp";

/**
 * Die Landingpage. Ziel jeder Anmeldung, deshalb muss sie tragen.
 *
 * Leitlinie fürs Visuelle: keine Krypto-Bildsprache. Keine glänzenden
 * Münzen, keine Kerzencharts als Deko, keine Stockfotos. Das ist die
 * Bildsprache genau der Leute, gegen die wir anschreiben — ein
 * einziges davon macht die Seite unglaubwürdig.
 *
 * Stattdessen belegt hier alles Visuelle etwas: die Ampel ist live,
 * der Zähler ist live, das Balkendiagramm zeigt den Kernbefund, die
 * Vorschau ist das echte Template. Dekoration gibt es an genau einer
 * Stelle, und das ist das Maskottchen.
 *
 * Zwei Rubriken, nicht drei. Drei Rubriken sind drei Versprechen, die
 * 52-mal gehalten werden müssen.
 *
 * „Wie ich das sehe" und der Bullshit Burner stehen trotzdem auf der
 * Seite — aber ausdrücklich als das, was sie sind: optional, im Schema
 * auch. Ein genanntes Extra ist kein Versprechen, solange danebensteht,
 * dass es nicht jede Woche kommt.
 *
 * Zwei Formulare, nicht drei: oben und unten. Ein drittes in der
 * Mitte zeigte denselben Block mit demselben Einwilligungstext ein
 * drittes Mal.
 */
const NAME = "Bullshitmelder";
const titel = `${NAME} — der Newsletter | Bit & Bullshit`;
const beschreibung =
  "Jeden Freitagmorgen: wie der Bitcoin-Markt gerade steht, nach festen Regeln gemessen — und was davon Bedeutung hat. Keine Kursziele, keine Empfehlungen.";
---

<Layout title={titel} description={beschreibung}>
  <SiteHeader />

  <main class="mx-auto max-w-3xl px-5 py-12 md:py-16">
    <Brotkrumen pfad={[{ label: "Start", href: "/" }, { label: NAME }]} />

    <p class="display mt-8 text-xs tracking-[0.3em] text-orange">// Freitagmorgen</p>
    <h1 class="display mt-4 text-4xl md:text-6xl">{NAME}</h1>
    <p class="mt-5 max-w-2xl text-lg opacity-85">
      Einmal die Woche eine Mail: wie der Markt gerade steht, nach festen Regeln
      gemessen, und was davon Bedeutung hat.
    </p>

    {/* Die Ampel als Erstes — wer hier landet, soll in der ersten
        Sekunde sehen, dass ein laufendes System dahintersteht und
        nicht bloss ein Versprechen. */}
    <div class="mt-9">
      <AmpelHero />
    </div>

    <div class="mt-9">
      <NewsletterForm variante="inline" quelle="landingpage" aufLandingpage />
    </div>

    {/* Der Zähler. Der stärkste Teaser, den wir haben — eine Zahl,
        die jeden Tag wächst und dem widerspricht, was anderswo über
        Funding steht. */}
    <div class="mt-14">
      <FundingZaehler />
    </div>

    <div class="post-body mt-14">
      <h2>Woher diese Zahl kommt</h2>
      <p>
        Die Funding Rate gilt als der Überhitzungsanzeiger schlechthin. Beim
        Nachrechnen für unser Ampelsystem kam heraus: Der Wert, auf den es dabei
        ankommt, ist seit dem 23.&nbsp;Juli 2025 nicht ein einziges Mal
        aufgetreten.
      </p>

      <JahresBalken />

      <p>
        Genau diese Art Befund steht im {NAME}. Nicht die Zahl selbst — die ist
        <a href="https://bitcoinaera.de/ampel/" rel="noopener">öffentlich</a>
        und bleibt es. Sondern was sie bedeutet und was nicht.
      </p>

      <h2>Was drinsteht</h2>
      <p>
        Zwei Rubriken. Nicht mehr — drei Rubriken sind drei Versprechen, die
        52-mal im Jahr gehalten werden müssen.
      </p>

      <h3>1. Der Stand</h3>
      <p>
        Wie die <a href="https://bitcoinaera.de/ampel/" rel="noopener"
          >Bitcoin-Ampel</a
        > steht und warum. Welche der vier Kennzahlen sich bewegt hat, was das
        historisch bedeutet hat und was nicht. Wenn nichts passiert ist, steht
        da, dass nichts passiert ist — das ist auch eine Information.
      </p>
      <p>
        Wenn es etwas zu sagen gibt, kommen zwei Rubriken dazu, die keine
        wöchentliche Pflicht sind: <strong>Wie ich das sehe</strong> — meine
        Meinung, als solche gekennzeichnet und vom Rest getrennt. Und der
        <strong>Bullshit Burner</strong>, in dem sich Pete eine Behauptung
        vornimmt, die gerade die Runde macht, und nachrechnet, was von ihr
        übrig bleibt.
      </p>

      <h3>2. Der Leserbereich</h3>
      <p>
        Die ausführliche Fassung, im <a href="/leserbereich/">Leserbereich</a>.
        Das Passwort dafür steht in jeder Ausgabe —
        kein Konto, keine Registrierung, jede Woche ein neues. Was dort liegt,
        ist in fünf Blöcke sortiert:
      </p>
      <ol class="bausteine">
        <li>
          <strong>Stand jetzt.</strong> Die Ampel und ihre vier Kennzahlen, live
          beim Öffnen — nicht der Stand vom Freitag. Daneben, was sich seit dem
          Versand bewegt hat.
        </li>
        <li>
          <strong>Was bedeutet das.</strong> Zu jeder Kennzahl ein Absatz: was
          dieser Stand für die Positionierung heißt.
        </li>
        <li>
          <strong>Gesamtkontext.</strong> Die vier Befunde zu einer Lage
          verdichtet, in ein paar Sätzen.
        </li>
        <li>
          <strong>Deep Dive.</strong> Ein Thema ausführlich — der Teil, der auch
          in drei Wochen noch stimmt.
        </li>
        <li>
          <strong>Was die Zahlen messen.</strong> Die vier Definitionen, fest
          unter jeder Ausgabe. Zum Nachschlagen, ohne die Seite zu verlassen.
        </li>
      </ol>
      <p>
        Dazu die <strong>Trefferbilanz</strong>: wie oft die Ampel Grün, Gelb
        und Rot gezeigt hat, gegen das, was das Regelwerk erwarten lässt. Also
        auch die Wochen, in denen sie danebenlag.
      </p>
      <p>
        Jeder Report wird <strong>drei Wochen später öffentlich</strong> und
        landet im <a href="/leserreports/">Archiv</a>. Die jüngsten zwei bleiben
        immer hinter dem Passwort — sonst hätte ein Abonnement keinen Vorsprung.
      </p>

      <h2>Was nicht drinsteht</h2>
      <p>
        Keine Kursziele. Keine Kauf- oder Verkaufsempfehlungen. Keine Signale,
        keine Trades, keine „letzte Chance". Der {NAME} beschreibt einen Zustand
        und erklärt Mechanik — was jemand daraus macht, ist seine Sache und
        bleibt es.
      </p>

      <h2>So sieht es aus</h2>
      <p>
        Vier Blätter zum Durchklicken: die Mail, wie sie freitags ankommt, und
        drei Seiten aus dem Leserbereich dahinter.
      </p>
      <AusgabeStapel />
      <p>
        Ältere Ausgaben stehen im
        <a href="/bullshitmelder/archiv/">Ausgaben-Archiv</a>, die Reports aus
        dem Leserbereich unter <a href="/leserreports/">Leserreports</a>.
      </p>

      {/* Der Weg hinein. Stand vorher nur als Wort mitten im Fliesstext —
          wer die Seite ueberfliegt, fand ihn nicht. Bewusst OHNE
          Anmeldeformular: Das steht direkt darunter schon, und ein
          drittes waere dasselbe Feld zum dritten Mal. */}
      <aside class="lb-tuer">
        <p class="lb-tuer-k">// Schon Abonnent?</p>
        <p class="display lb-tuer-h">Hier geht es zum Leserbereich</p>
        <p class="lb-tuer-t">
          Das Passwort der Woche steht in der Mail von Freitag, ganz unten. Ein
          Feld, kein Konto.
        </p>
        <p class="lb-tuer-aktion">
          <a class="lb-tuer-knopf" href="/leserbereich/">Leserbereich öffnen</a>
          <a class="lb-tuer-neben" href="/leserreports/"
            >oder ältere Reports lesen</a
          >
        </p>
      </aside>

      <div class="maskottchen-block">
        <Image
          src={maskottchen}
          alt="Pete mit Bitcoin-Cap, verschränkte Arme, skeptischer Blick"
          width={190}
          height={269}
          densities={[1, 2]}
          loading="lazy"
        />
        <div>
          <p class="display maskottchen-spruch">Einmal die Woche. Sonst Ruhe.</p>
          <p class="maskottchen-text">
            Keine Bestellbestätigungen, keine „nur noch heute", keine dritte Mail
            in derselben Woche. Freitagmorgen, und das war es.
          </p>
        </div>
      </div>

      <h2>Frequenz und Kleingedrucktes</h2>
      <ul>
        <li><strong>Freitagmorgen</strong>, einmal die Woche.</li>
        <li>Bestätigung per Mail. Ohne den Klick darin tragen wir dich nicht ein.</li>
        <li>Abmeldung mit einem Klick in jeder Ausgabe. Keine Rückfrage.</li>
        <li>
          Versand über Brevo, Server in der EU. Was gespeichert wird, steht im
          <a href="/datenschutz/">Datenschutz</a>.
        </li>
        <li>
          Die Reports aus dem Leserbereich werden nach
          <strong>drei Wochen</strong> öffentlich, die Ausgaben selbst nach
          <strong>8 bis 12 Wochen</strong>. Wer wartet, verpasst nichts — er
          erfährt es später.
        </li>
      </ul>

      <h2>Warum überhaupt</h2>
      <p>
        Funding Rates, ETF-Flüsse und Stablecoin-Zahlen sind frei verfügbar.
        Jeder kann sie nachschlagen. Was fehlt, ist die Einordnung: Ist dieser
        Wert hoch? Verglichen womit? Und was heißt das für jemanden, der einfach
        nur wissen will, wie die Lage ist?
      </p>
      <p>
        Der {NAME} macht diese Arbeit einmal die Woche. Die Zahlen sind
        öffentlich, das
        <a href="https://bitcoinaera.de/ampel/regeln/" rel="noopener">Regelwerk</a>
        auch — samt der Stellen, an denen es noch nichts beweisen kann.
        Zurückgehalten wird keine Information, nur die Arbeit, sie zu sortieren.
      </p>
    </div>

    <div class="mt-14">
      <NewsletterForm variante="artikel-ende" quelle="landingpage-fuss" aufLandingpage />
    </div>
  </main>

  <SiteFooter />
</Layout>

<style>
  /* Die Tuer zum Leserbereich. Orange Kante links wie die
     Meinungsrubrik — ein Kasten, der etwas anbietet, kein Hinweis. */
  .lb-tuer {
    margin: 2.75rem 0 0;
    padding: 1.6rem 1.5rem 1.5rem;
    background: rgb(from var(--color-paper) r g b / 0.05);
    border-left: 3px solid var(--color-orange, #f7931a);
  }
  .lb-tuer-k {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-orange, #f7931a);
  }
  .lb-tuer-h {
    margin: 0.55rem 0 0;
    font-size: clamp(1.2rem, 4.5vw, 1.6rem);
    line-height: 1.15;
  }
  .lb-tuer-t {
    margin: 0.65rem 0 0;
    font-size: 0.92rem;
    line-height: 1.65;
    opacity: 0.75;
    max-width: 34rem;
  }
  .lb-tuer-aktion {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.1rem;
    margin: 1.2rem 0 0;
  }
  .lb-tuer-knopf {
    display: inline-block;
    padding: 0.7rem 1.3rem;
    background: var(--color-orange, #f7931a);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    border: 0;
  }
  .lb-tuer-knopf:hover { background: #ffa63a; }
  .lb-tuer-neben { font-size: 0.85rem; opacity: 0.7; }

  .maskottchen-block {
    display: flex;
    align-items: flex-end;
    gap: 1.4rem;
    margin: 3rem 0;
    padding-top: 1.6rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .maskottchen-block img {
    flex: none;
    width: 130px;
    height: auto;
  }
  .maskottchen-spruch {
    margin: 0;
    font-size: clamp(1.3rem, 5vw, 1.8rem);
    line-height: 1.1;
  }
  .maskottchen-text {
    margin: 0.6rem 0 0;
    font-size: 0.95rem;
    opacity: 0.75;
  }
  @media (max-width: 34rem) {
    .maskottchen-block { gap: 1rem; }
    .maskottchen-block img { width: 92px; }
  }
</style>
