---
import Layout from "../../layouts/Layout.astro";
import Brotkrumen from "../../components/Brotkrumen.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import RatgeberKarten from "../../components/RatgeberKarten.astro";
import { ladeRatgeber } from "../../lib/ratgeber";

const ratgeber = await ladeRatgeber();
---

<Layout
  title="Ratgeber — Bit & Bullshit"
  description="Fünf Ratgeber zu Bitcoin, Geld und den Denkfehlern drumherum. Je fünf Teile, zum Durchlesen statt Durchscrollen."
>
  <SiteHeader />

  <main class="relative mx-auto max-w-5xl overflow-hidden px-5 py-16 md:py-24">

    <Brotkrumen pfad={[{ label: "Start", href: "/" }, { label: "Ratgeber" }]} />

    <header class="relative max-w-3xl">
      <span class="wall-ghost" aria-hidden="true">RATGEBER</span>
      <p class="display hero-layer text-xs tracking-[0.3em] text-orange">// RATGEBER</p>
      <h1 class="display spray-head hero-layer mt-4 text-4xl md:text-6xl">
        Zum <span class="marker">Durchlesen.</span>
      </h1>
      <p class="hero-layer mt-8 text-lg leading-relaxed text-paper/80">
        Snippets erklären ein Thema in 60 Sekunden. Die Ratgeber nehmen sich
        Zeit: je fünf Teile, die aufeinander aufbauen. Für die Fragen, bei
        denen eine Minute nicht reicht.
      </p>
    </header>

    <div class="mt-14">
      <RatgeberKarten />
    </div>

    {
      ratgeber.length === 0 && (
        <p class="mt-12 text-paper/60">
          Noch kein Ratgeber veröffentlicht. Die Snippets gibt es schon —
          <a href="/snippets" class="drip-underline text-paper hover:text-orange">
            hier entlang
          </a>.
        </p>
      )
    }
  </main>

  <SiteFooter />
</Layout>
