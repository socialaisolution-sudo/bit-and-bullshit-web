---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import Brotkrumen from "../../components/Brotkrumen.astro";

/**
 * Die Landingpage.
 *
 * Zwei Rubriken, nicht drei. Drei Rubriken sind drei Versprechen, die
 * 52-mal gehalten werden müssen — die dritte kommt erst, wenn die
 * ersten beiden zehn Wochen stabil laufen.
 *
 * Der Name steht noch nicht fest. „Das Briefing" ist Platzhalter und
 * steht an genau einer Stelle in NewsletterForm.astro sowie hier —
 * Umbenennen ist zwei Zeilen, keine Suche.
 *
 * „Eine komplette echte Ausgabe verlinkt" fehlt noch, weil es noch
 * keine gibt. Der Block steht bereit und ist auskommentiert; sobald
 * Ausgabe eins draußen ist, wird er sichtbar. Ein Link auf eine
 * Beispielausgabe, die es nicht gibt, wäre schlimmer als keiner.
 */
const NAME = "Das Briefing";
const titel = `${NAME} — jeden Freitagmorgen | Bit & Bullshit`;
const beschreibung =
  "Einmal die Woche, Freitagmorgen: wie der Bitcoin-Markt gerade steht, nach festen Regeln gemessen — und was davon Bedeutung hat. Keine Kursziele, keine Empfehlungen.";
---

<Layout title={titel} description={beschreibung}>
  <SiteHeader />

  <main class="mx-auto max-w-3xl px-5 py-14 md:py-20">
    <Brotkrumen
      pfad={[{ label: "Start", href: "/" }, { label: "Briefing" }]}
    />

    <p class="display mt-8 text-xs tracking-[0.3em] text-orange">// Freitagmorgen</p>
    <h1 class="display mt-4 text-4xl md:text-5xl">{NAME}</h1>
    <p class="mt-5 max-w-2xl text-lg opacity-85">
      Einmal die Woche eine Mail: wie der Markt gerade steht, nach festen
      Regeln gemessen, und was davon Bedeutung hat.
    </p>

    <div class="mt-10">
      <NewsletterForm variante="inline" quelle="landingpage" />
    </div>

    <div class="post-body mt-14">
      <h2>Was drinsteht</h2>
      <p>
        Zwei Rubriken. Nicht mehr — drei Rubriken sind drei Versprechen, die
        52-mal im Jahr gehalten werden müssen.
      </p>

      <h3>1. Der Stand</h3>
      <p>
        Wie die <a href="https://bitcoinaera.de/ampel/" rel="noopener"
          >Bitcoin-Ampel</a
        > steht und warum. Welche der vier Kennzahlen sich bewegt hat, was das
        historisch bedeutet hat und was nicht. Wenn nichts passiert ist, steht
        da, dass nichts passiert ist — das ist auch eine Information.
      </p>

      <h3>2. Der Zugang zum Leserbereich</h3>
      <p>
        Das Passwort der Woche. Dahinter liegen die ausführliche Auswertung,
        die historischen Verläufe und die Vergleiche über mehrere Zeiträume.
      </p>

      <h2>Was nicht drinsteht</h2>
      <p>
        Keine Kursziele. Keine Kauf- oder Verkaufsempfehlungen. Keine Signale,
        keine Trades, keine „letzte Chance". Das Briefing beschreibt einen
        Zustand und erklärt Mechanik — was jemand daraus macht, ist seine
        Sache und bleibt es.
      </p>

      <h2>Frequenz und Kleingedrucktes</h2>
      <ul>
        <li><strong>Freitagmorgen</strong>, einmal die Woche.</li>
        <li>
          Bestätigung per Mail. Ohne den Klick darin tragen wir dich nicht ein.
        </li>
        <li>Abmeldung mit einem Klick in jeder Ausgabe. Keine Rückfrage.</li>
        <li>
          Versand über Brevo, Server in der EU. Was gespeichert wird, steht im
          <a href="/datenschutz/">Datenschutz</a>.
        </li>
        <li>
          Die Inhalte erscheinen <strong>8 bis 12 Wochen später</strong> auch
          öffentlich. Wer wartet, verpasst nichts — er erfährt es später.
        </li>
      </ul>

      {/* Sobald Ausgabe eins draußen ist:
          <h2>So sieht es aus</h2>
          <p><a href="/newsletter/…/">Die komplette erste Ausgabe lesen</a></p>
          „So sieht es aus" schlägt jede Beschreibung — aber erst, wenn
          es die Ausgabe wirklich gibt. */}

      <h2>Warum überhaupt</h2>
      <p>
        Funding Rates, ETF-Flüsse und Stablecoin-Zahlen sind frei verfügbar.
        Jeder kann sie nachschlagen. Was fehlt, ist die Einordnung: Ist dieser
        Wert hoch? Verglichen womit? Und was heißt das für jemanden, der
        einfach nur wissen will, wie die Lage ist?
      </p>
      <p>
        Das Briefing macht diese Arbeit einmal die Woche. Die Zahlen sind
        <a href="https://bitcoinaera.de/ampel/" rel="noopener">öffentlich</a>,
        das Regelwerk auch. Zurückgehalten wird keine Information — nur die
        Arbeit, sie zu sortieren.
      </p>
    </div>

    <div class="mt-14">
      <NewsletterForm variante="artikel-ende" quelle="landingpage-fuss" />
    </div>
  </main>

  <SiteFooter />
</Layout>
