---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { KATEGORIE_MAP } from "../data/kategorien";

interface Props {
  /** Slug des Artikels, unter dem der Block steht. */
  aktuell: string;
  anzahl?: number;
}
const { aktuell, anzahl = 3 } = Astro.props;

/**
 * „Das könnte dich auch interessieren“ — Nachbarn aus derselben Rubrik.
 *
 * Ausgewählt wird nach Nähe in der Reihenfolge, nicht nach Zufall: Artikel,
 * die kurz nacheinander entstanden sind, gehören meist zum selben Anlass und
 * lesen sich hintereinander sinnvoll. Ein Zufallsgenerator wäre bei jedem
 * Build anders und würde Google wechselnde Links zeigen.
 *
 * Reicht die Rubrik nicht für die gewünschte Zahl, füllen die nächsten
 * Nachbarn aus dem Gesamtbestand auf — ein halb gefüllter Block sieht nach
 * Fehler aus.
 */
const alle = await getCollection("blog", ({ data }) => data.draft !== true);
const ich = alle.find((p) => p.id === aktuell);

const nachNaehe = (kandidaten: typeof alle) =>
  [...kandidaten]
    .filter((p) => p.id !== aktuell)
    .sort(
      (a, b) =>
        Math.abs(a.data.order - (ich?.data.order ?? 0)) -
        Math.abs(b.data.order - (ich?.data.order ?? 0)),
    );

const ausRubrik = nachNaehe(
  alle.filter((p) => p.data.kategorie === ich?.data.kategorie),
);
const auffueller = nachNaehe(alle).filter(
  (p) => !ausRubrik.slice(0, anzahl).some((r) => r.id === p.id),
);
const empfehlungen = [...ausRubrik, ...auffueller].slice(0, anzahl);

const rubrik = ich ? KATEGORIE_MAP[ich.data.kategorie] : undefined;
---

{
  empfehlungen.length > 0 && (
    <aside class="mt-16 border-t border-white/10 pt-10" data-pagefind-ignore>
      <p class="display text-xs tracking-[0.3em] text-orange">// WEITERLESEN</p>
      <h2 class="display mt-3 text-2xl md:text-3xl">
        Das könnte dich auch interessieren
      </h2>

      <ul class="mt-7 grid gap-4 sm:grid-cols-3">
        {empfehlungen.map((p) => (
          <li>
            <a
              href={`/snippets/${p.id}`}
              class="verwandt-karte group block h-full overflow-hidden rounded-md border border-white/10 bg-ink/60 transition hover:border-orange/50"
            >
              {p.data.image && (
                <Image
                  src={p.data.image}
                  alt=""
                  widths={[240, 360, 480]}
                  sizes="(min-width: 640px) 15rem, 92vw"
                  class="block h-28 w-full object-cover"
                  loading="lazy"
                />
              )}
              <span class="block p-4">
                <span class="display block text-xs tracking-[0.2em] text-orange/80">
                  {KATEGORIE_MAP[p.data.kategorie].titel}
                </span>
                <span class="display mt-2 block text-[0.95rem] leading-snug transition group-hover:text-orange">
                  {p.data.title}
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>

      {rubrik && (
        <p class="mt-6 text-sm text-paper/60">
          Alle Artikel aus dieser Rubrik:
          <a
            href={`/kategorie/${rubrik.key}/`}
            class="ml-1 underline decoration-orange/60 underline-offset-2 hover:text-orange"
          >
            {rubrik.titel} &rarr;
          </a>
        </p>
      )}
    </aside>
  )
}
