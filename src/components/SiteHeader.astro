---
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);

const links = [
  { href: "/", label: "Start" },
  { href: "/blog", label: "Blog" },
  { href: "/sticker", label: "Sticker" },
];
---

<header class="border-b border-white/10">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-5">
    <a href="/" class="display text-xl tracking-tight">
      Bit <span class="text-orange">&amp;</span> Bullshit
    </a>
    <ul class="flex items-center gap-6 text-xs uppercase tracking-widest">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "transition hover:text-orange",
                isActive(link.href) ? "text-orange" : "text-paper/70",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
