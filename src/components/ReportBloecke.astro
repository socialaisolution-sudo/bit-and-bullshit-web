---
/**
 * Die Bausteine 2 bis 5 eines Leserreports.
 *
 * Geteilt zwischen dem gesperrten Leserbereich und dem öffentlichen
 * Archiv — sonst laufen zwei Fassungen desselben Reports
 * auseinander, und das ist in diesem Projekt schon passiert.
 *
 * Baustein 1 (der Live-Stand) steckt NICHT hier: Im Leserbereich ist
 * er tagesaktuell und wird per fetch geholt, im Archiv ist er ein
 * eingefrorener Rückblick. Zwei verschiedene Dinge, zwei Stellen.
 */
import { render } from "astro:content";
import { KENNZAHLEN, REIHENFOLGE } from "../lib/kennzahlen";
import type { Report } from "../lib/leserbereich";

interface Props {
  report: Report;
  /* Die Nummerierung laeuft ueber die ganze Seite und beginnt bei 1
     (dem Live-Stand), der hier nicht steckt. Deshalb von aussen. */
  ab?: number;
}
const { report, ab = 2 } = Astro.props;
const nr = (n: number) => String(n).padStart(2, "0");
const d = report.data;
const { Content } = await render(report);

/* Fehlt das Feld, treten die festen Definitionen an seine Stelle —
   dann steht dort nie eine Lücke, nur etwas Allgemeineres. */
const hatBausteine = !!d.bausteine;
const notiz = d.notiz?.trim();
const deepDive = !!d.deepdive_titel?.trim();
---

{/* ===== 2 · Was bedeutet das konkret ===== */}
<section class="wall-sec">
  <header class="wall-head">
    <span class="stencil-num wall-head-num" aria-hidden="true">{nr(ab)}</span>
    <h2 class="display wall-h">Was bedeutet das</h2>
  </header>
  <div class="spray-rule mt-4 max-w-[12rem]"></div>
  {
    !hatBausteine && (
      <p class="lb-hinweis">
        Für diese Woche liegt keine Einordnung vor. Was die vier Kennzahlen
        messen, steht unverändert unten.
      </p>
    )
  }
  <div class="rb-karten">
    {
      REIHENFOLGE.map((k, i) => (
        <article class={`rb-karte paper tape ${i % 2 ? "tape-right" : "tape-left"}`}>
          <p class="stamp rb-name">{KENNZAHLEN[k].name}</p>
          <p class="rb-text">
            {hatBausteine ? d.bausteine![k] : KENNZAHLEN[k].misst}
          </p>
        </article>
      ))
    }
  </div>
</section>

{/* ===== 3 · Gesamtkontext ===== */}
{
  d.gesamtkontext?.trim() && (
    <section class="wall-sec rb-ghost-sec">
      <span class="wall-ghost" aria-hidden="true">LAGE</span>
      <header class="wall-head">
        <span class="stencil-num wall-head-num" aria-hidden="true">{nr(ab + 1)}</span>
        <h2 class="display wall-h">Gesamtkontext</h2>
      </header>
      <div class="spray-rule mt-4 max-w-[12rem]" />
      <p class="rb-gesamt">{d.gesamtkontext}</p>
    </section>
  )
}

{/* ===== Optional · Wie ich das sehe =====
     Zwischen 3 und 4, wie im Newsletter. Fehlt das Feld oder ist es
     leer, entfällt der Block ganz — kein leerer Kasten. */}
{
  notiz && (
    <section class="wall-sec rb-notiz">
      <p class="lb-kicker">// Meinung</p>
      <h2 class="display rb-notiz-h">Wie ich das sehe</h2>
      <p class="rb-text">{notiz}</p>
    </section>
  )
}

{/* ===== 4 · Deep Dive =====
     Titel fehlt heisst: kein Deep Dive. Lieber gar kein Block als
     eine Ueberschrift ohne Inhalt. */}
{
  deepDive && (
    <section class="wall-sec rb-deep rb-ghost-sec">
      <span class="wall-ghost" aria-hidden="true">MAKRO</span>
      <header class="wall-head">
        <span class="stencil-num wall-head-num" aria-hidden="true">{nr(ab + 2)}</span>
        <h2 class="display wall-h">Deep Dive</h2>
      </header>
      <div class="spray-rule mt-4 max-w-[12rem]" />
      <h3 class="display rb-deep-h">{d.deepdive_titel}</h3>
      {/* Dieselbe Lesespalte wie die Artikel: 44rem BEI 19px, also
          rund 74 Zeichen je Zeile. Vorher stand hier 44rem bei 16px —
          gleiche Breite, kleinere Schrift, 88 Zeichen. Das liest sich
          als Wand, und genau so sah es aus. */}
      <div class="post-body rb-deep-text">
        <Content />
      </div>
      {d.deepdive_quellen?.trim() && (
        <p class="rb-quellen">
          <strong>Quellen:</strong> {d.deepdive_quellen}
        </p>
      )}
    </section>
  )
}

<style>
    .rb-karten {
    display: grid;
    gap: 2rem 1.5rem;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    margin-top: 2.25rem;
  }
  @media (min-width: 720px) {
    .rb-karten { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.25rem 2rem; }
  }
  /* Geklebte Zettel statt flacher Kaesten — dieselbe Sprache wie die
     Zielgruppen-Zettel auf der Ueber-Seite. Die Neigung wechselt, damit
     die vier nicht wie ein Raster wirken. */
  .rb-karte {
    padding: 1.6rem 1.35rem 1.4rem;
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .rb-karten > .rb-karte:nth-child(1) { transform: rotate(-1.4deg); }
  .rb-karten > .rb-karte:nth-child(2) { transform: rotate(1.1deg); }
  .rb-karten > .rb-karte:nth-child(3) { transform: rotate(0.9deg); }
  .rb-karten > .rb-karte:nth-child(4) { transform: rotate(-1deg); }
  .rb-karte:hover { transform: rotate(0deg) translateY(-3px); }
  .rb-name { margin: 0; }
  .rb-text {
    margin: 0.85rem 0 0;
    font-size: 0.95rem;
    line-height: 1.68;
    color: rgb(from var(--color-ink) r g b / 0.84);
  }

  @media (prefers-reduced-motion: reduce) {
    .rb-karte, .rb-karte:hover { transform: none; transition: none; }
  }

  /* Die Verdichtung darf lauter sein als der Rest, aber nicht
     breiter — dieselbe Zeichenzahl je Zeile wie der Deep Dive. */
  /* Die Geisterschrift sitzt hinter dem Text, nicht daneben — sie ist
     Textur, kein Inhalt, und traegt deshalb aria-hidden. */
  .rb-ghost-sec { position: relative; overflow: hidden; }
  .rb-ghost-sec > .wall-ghost { top: 1.5rem; right: -1rem; font-size: clamp(3rem, 12vw, 7rem); }
  .rb-ghost-sec > * { position: relative; }

  .rb-gesamt {
    margin: 1.75rem 0 0;
    font-size: 1.15rem;
    line-height: 1.75;
    max-width: 38rem;
    color: rgb(from var(--color-paper) r g b / 0.88);
  }

  /* Die Meinung setzt sich ab wie im Newsletter: eigene Flaeche,
     Ueberschrift in Textfarbe statt in Orange — sie ist kein
     Zwischentitel, sondern ein anderer Sprecher. */
  /* Die Meinung setzt sich als Flaeche ab, nicht als nummerierter
     Abschnitt — sie gehoert nicht in die Zaehlung der Bausteine. */
  .rb-notiz {
    background: rgb(from var(--color-paper) r g b / 0.045);
    border-left: 3px solid var(--color-orange, #f7931a);
    padding: 1.75rem 1.5rem 1.6rem;
    margin-top: 1rem;
  }
  .rb-notiz-h { font-size: 1.3rem; margin: 0 0 0.75rem; }

  .rb-deep-h {
    font-size: clamp(1.3rem, 4vw, 1.9rem);
    line-height: 1.25;
    margin: 1.75rem 0 1.25rem;
    max-width: 40rem;
  }
  /* Die Absaetze bekommen gesprühte Umriss-Ziffern in der Spalte
     links, wie die Zwischentitel im Blog. Dennys Deep Dive ist eine
     Beweisfuehrung in vier Schritten — als vier gleich graue Bloecke
     sieht man das nicht, als 01 bis 04 sofort.

     Eigener Zaehler, nicht der aus .post-body: Sonst kollidiert es,
     sobald jemand doch einmal ein ## in den Text setzt. */
  .rb-deep-text { margin-top: 0; counter-reset: ddabsatz; }

  .rb-deep-text :global(> p) {
    counter-increment: ddabsatz;
    position: relative;
    padding-left: 3.4rem;
  }
  .rb-deep-text :global(> p::before) {
    content: counter(ddabsatz, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.12em;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 2.1rem;
    line-height: 0.9;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(from var(--color-orange) r g b / 0.5);
    user-select: none;
  }
  /* Ein Zwischentitel setzt die Zaehlung nicht fort — er bekommt die
     eigene Nummerierung von .post-body. */
  .rb-deep-text :global(> h2) { padding-left: 0; }

  /* Sobald der Text Zwischentitel hat, zaehlen die — und die Absaetze
     hoeren auf zu zaehlen. Zwei Nummerierungen uebereinander liest
     niemand, und die Ziffern in der Spalte sind ohnehin nur der Ersatz
     fuer die Gliederung, die ein Text ohne ## nicht hat.
     Stellt sich von selbst um, je nachdem was in der Wochendatei steht. */
  /* padding-top muss mit weg, sonst klafft unter 40rem ueber jedem
     Absatz die Luecke, in der sonst die Ziffer sitzt. */
  .rb-deep-text:has(> h2) :global(> p) { padding-left: 0; padding-top: 0; }
  .rb-deep-text:has(> h2) :global(> p::before) { content: none; }
  .rb-deep-text:has(> h2) :global(> blockquote) { margin-left: 0; }

  /* Ein Zitat mit > steht sonst am linken Rand des Abschnitts, waehrend
     alle Absaetze um 3,4rem eingerueckt sind — das sah aus wie ein
     Versehen. Jetzt steht es in derselben Spalte, mit einer Flaeche
     hinter der Kante wie die Meinung weiter oben.

     Hervorhebung geht ueber das >, nicht ueber die Position im Text.
     Welcher Satz heraussticht, ist eine Entscheidung beim Schreiben. */
  .rb-deep-text :global(> blockquote) {
    margin-left: 3.4rem;
    padding: 1rem 1.2rem 1rem 1.15rem;
    background: rgb(from var(--color-paper) r g b / 0.045);
  }
  @media (max-width: 40rem) {
    .rb-deep-text :global(> blockquote) { margin-left: 0; }
  }

  /* Auf schmalen Schirmen steht die Ziffer ueber dem Absatz statt
     daneben — 3,4rem Einzug fressen dort ein Achtel der Zeile. */
  @media (max-width: 40rem) {
    .rb-deep-text :global(> p) { padding-left: 0; padding-top: 1.9rem; }
    .rb-deep-text :global(> p::before) { font-size: 1.7rem; top: 0; }
  }
  .rb-quellen { margin: 1.5rem 0 0; font-size: 0.8rem; line-height: 1.6; opacity: 0.55; max-width: 44rem; }
</style>
