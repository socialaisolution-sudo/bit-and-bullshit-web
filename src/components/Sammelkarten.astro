---
/**
 * Pete-Sammelkarten — Galerie aller 21 Karten.
 *
 * Klick auf eine Karte oeffnet sie gross; ziehen oder wischen dreht sie auf
 * die Rueckseite, darunter steht die Story. Tiefenlink `#k05` oeffnet Karte 5
 * direkt — dafuer sind die QR-Codes auf den gedruckten Karten gedacht.
 *
 * Uebernommen aus dem Prototyp in Desktop/Sammelkarten/web. Drei Dinge sind
 * beim Einbau bewusst anders:
 *
 *  1. KEINE Google Fonts. Der Prototyp lud Anton, Barlow und Permanent Marker
 *     von fonts.googleapis.com. Diese Seite hostet ihre Schriften selbst
 *     (public/fonts/, als woff2 vorgeladen) — und zwar nicht aus Geschmack:
 *     ein Abruf bei Google uebertraegt die IP jedes Besuchers dorthin. Statt
 *     drei fremder Schriften laufen die Karten auf den beiden eigenen,
 *     `--font-display` (Archivo Black) und `--font-body` (Inter).
 *     Der handschriftliche Akzent (vorher Permanent Marker) ist durch eine
 *     leichte Drehung und die Markenfarbe ersetzt.
 *
 *  2. Markenfarbe statt eigenem Orange. Der Prototyp brachte #ff8a00 mit, die
 *     Seite benutzt ueberall #f7931a (Bitcoin-Orange). Zwei fast gleiche
 *     Orangetoene nebeneinander sieht aus wie ein Fehler, nicht wie Absicht.
 *
 *  3. Die Daten liegen in src/data/, wo in diesem Projekt alle Daten liegen
 *     (begriffe.json, kategorien.ts), nicht neben der Komponente.
 */
import data from "../data/sammelkarten.json";

/* Pfad-Prefix zu den Bildern in /public. Liegen sie woanders, reicht es,
   diese eine Zeile zu aendern. */
const BASE = "/sammelkarten/";
---

<style is:global>
  .sk-root,
  .sk-overlay {
    /* Eigene Tokens, bewusst mit anderen Namen als die der Seite
       (--color-ink, --color-paper, --color-orange), damit sich nichts
       gegenseitig ueberschreibt. Die Akzentfarbe zieht sich aus dem
       Markentoken, damit beide Werte nie auseinanderlaufen. */
    --sk-bg: #0c0c0c;
    --sk-bg2: #141414;
    --sk-panel: #1a1a1a;
    --sk-line: #2b2b2b;
    --sk-fg: #f3f1ee;
    --sk-muted: #9a948c;
    --sk-concrete: #6f6a63;
    --sk-accent: var(--color-orange);
    --sk-accent-2: var(--color-orange-deep);
    --sk-ink: #111;
    --sk-card-w: min(78vw, 340px);
  }

  /* Nur noch Hülle, kein eigener Hintergrund. Der Prototyp brachte einen
     eigenen Verlauf mit — eingebaut in die Seite ergab das eine sichtbare
     Kante dort, wo das fremde Stück anfing. Das Raster sitzt jetzt auf dem
     Seitengrund, und der Seitenkopf steht in sammelkarten.astro, im selben
     Stil wie das Metaphern-Register. */
  .sk-root {
    color: var(--sk-fg);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  .sk-count {
    display: inline-flex; align-items: center; gap: 8px; margin-top: 16px;
    font-family: var(--font-display); font-size: 14px; letter-spacing: .08em;
    background: var(--sk-panel); border: 1px solid var(--sk-line);
    padding: 7px 14px; border-radius: 999px; text-transform: uppercase;
  }
  .sk-count b { color: var(--sk-accent); }

  .sk-grid {
    display: grid; gap: 14px; padding-block: 22px 44px;
    grid-template-columns: repeat(auto-fill, minmax(148px, 1fr));
  }
  .sk-tile {
    position: relative; aspect-ratio: 2.5 / 3.5; border: 0; padding: 0;
    cursor: pointer; background: transparent; border-radius: 12px;
    overflow: hidden; transition: transform .18s ease, box-shadow .18s ease;
    box-shadow: 0 6px 18px rgba(0, 0, 0, .45);
  }
  .sk-tile:hover, .sk-tile:focus-visible {
    transform: translateY(-5px) rotate(-.6deg);
    box-shadow: 0 14px 30px rgba(0, 0, 0, .6); outline: none;
  }
  .sk-tile:focus-visible { box-shadow: 0 0 0 3px var(--sk-accent), 0 14px 30px rgba(0, 0, 0, .6); }
  .sk-tile img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sk-num {
    position: absolute; top: 8px; right: 8px; z-index: 3;
    font-family: var(--font-display); font-size: 12px;
    background: rgba(12, 12, 12, .82); border: 1.5px solid var(--sk-accent);
    color: var(--sk-fg); border-radius: 999px; padding: 3px 9px; line-height: 1;
  }
  .sk-num b { color: var(--sk-accent); }

  .sk-overlay {
    position: fixed; inset: 0; z-index: 50; display: none;
    background: rgba(6, 6, 6, .9); backdrop-filter: blur(7px);
    padding: max(14px, env(safe-area-inset-top)) 14px max(14px, env(safe-area-inset-bottom));
    overflow: auto;
  }
  .sk-overlay.open { display: flex; flex-direction: column; align-items: center; }
  .sk-obar { width: 100%; max-width: 560px; display: flex; justify-content: space-between; align-items: center; gap: 10px; margin: 2px 0 10px; }
  .sk-ser { font-family: var(--font-display); color: var(--sk-accent); font-size: 13px; letter-spacing: .1em; }
  .sk-ic {
    width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--sk-line);
    background: var(--sk-panel); color: var(--sk-fg); font-size: 19px;
    cursor: pointer; display: grid; place-items: center;
  }
  .sk-ic:active { transform: scale(.94); }
  .sk-ic:focus-visible { outline: 2px solid var(--sk-accent); outline-offset: 2px; }
  .sk-stage { perspective: 1400px; width: var(--sk-card-w); margin: 0 auto; touch-action: pan-y; flex: none; }
  .sk-flip {
    position: relative; width: 100%; aspect-ratio: 2.5 / 3.5;
    transform-style: preserve-3d; transition: transform .55s cubic-bezier(.2, .7, .2, 1);
    cursor: grab; will-change: transform;
  }
  .sk-flip.drag { transition: none; cursor: grabbing; }
  .sk-face {
    position: absolute; inset: 0; backface-visibility: hidden;
    -webkit-backface-visibility: hidden; border-radius: 16px; overflow: hidden;
    box-shadow: 0 22px 50px rgba(0, 0, 0, .65); background: var(--sk-bg2);
  }
  .sk-face img { width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; }
  .sk-face.back { transform: rotateY(180deg); }
  .sk-hint { display: flex; align-items: center; justify-content: center; gap: 8px; color: var(--sk-muted); font-size: 13px; margin: 12px 0 4px; }
  .sk-hint svg { width: 17px; height: 17px; fill: none; stroke: var(--sk-accent); stroke-width: 2; }
  .sk-flipbtn {
    display: inline-flex; align-items: center; gap: 8px; margin: 2px auto 0;
    font-family: var(--font-display); letter-spacing: .06em; text-transform: uppercase;
    font-size: 13px; background: var(--sk-accent); color: var(--sk-ink);
    border: 0; border-radius: 999px; padding: 9px 18px; cursor: pointer;
  }
  .sk-flipbtn:active { transform: scale(.96); }
  .sk-story {
    width: 100%; max-width: 560px; margin: 18px auto 8px; position: relative;
    background:
      repeating-linear-gradient(135deg, rgb(from var(--sk-accent) r g b / .05) 0 3px, transparent 3px 9px),
      var(--sk-panel);
    border: 1px solid var(--sk-line); border-top: 4px solid var(--sk-accent);
    border-radius: 12px; padding: 18px 18px 20px; box-shadow: 0 14px 34px rgba(0, 0, 0, .5);
  }
  .sk-stno {
    position: absolute; top: -14px; right: 14px; font-family: var(--font-display);
    font-size: 13px; background: var(--sk-accent); color: var(--sk-ink);
    padding: 4px 11px; border-radius: 999px;
  }
  .sk-story h2 {
    font-family: var(--font-display); font-weight: 400; text-transform: uppercase;
    font-size: clamp(22px, 5vw, 30px); line-height: .98; margin: 0 0 4px; text-wrap: balance;
  }
  /* Der Spruch stand im Prototyp in Permanent Marker. Leicht gedreht und in
     der Markenfarbe liest er sich weiter als Zitat von der Karte. */
  .sk-spruch {
    font-family: var(--font-display); color: var(--sk-accent-2);
    font-size: 15px; line-height: 1.35; letter-spacing: .02em;
    transform: rotate(-.7deg); transform-origin: left center; margin: 0 0 14px;
  }
  .sk-txt { margin: 0; font-size: 15.5px; line-height: 1.62; color: #e7e2db; max-width: 60ch; }
  .sk-idline {
    margin-top: 14px; padding-top: 12px; border-top: 1px dashed var(--sk-line);
    display: flex; justify-content: space-between; align-items: center;
    font-family: var(--font-display); font-size: 12px; letter-spacing: .12em; color: var(--sk-concrete);
  }
  .sk-idline .brand { color: var(--sk-fg); }
  .sk-idline .brand b { color: var(--sk-accent); }
  .sk-foot { color: var(--sk-concrete); text-align: center; font-size: 12px; padding: 10px 0 30px; }
  .sk-nav { display: flex; gap: 10px; max-width: 560px; width: 100%; margin: 4px auto 20px; }
  .sk-nav button { flex: 1; border-radius: 10px; width: auto; }

  @media (prefers-reduced-motion: reduce) {
    .sk-flip, .sk-tile { transition: none; }
  }
</style>

<div class="sk-root">
  <div class="sk-count">21 Karten · <b>/21</b> wie 21 Mio.</div>
  <div class="sk-grid" id="skGrid" aria-label="Alle 21 Sammelkarten"></div>
  <div class="sk-foot">
    Zieh oder wisch über die Karte, um sie zu drehen. · Erhältlich nur als
    komplettes 21er-Set.
  </div>
</div>

<div class="sk-overlay" id="skOverlay" role="dialog" aria-modal="true" aria-label="Kartenansicht">
  <div class="sk-obar">
    <button class="sk-ic" id="skPrev" aria-label="Vorherige Karte">‹</button>
    <div class="sk-ser" id="skSer">01 / 21</div>
    <button class="sk-ic" id="skClose" aria-label="Schließen">✕</button>
  </div>
  <div class="sk-stage" id="skStage">
    <div class="sk-flip" id="skFlip">
      <div class="sk-face front" id="skFront"></div>
      <div class="sk-face back" id="skBack"></div>
    </div>
  </div>
  <div class="sk-hint">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path>
      <path d="M21 3v5h-5"></path>
      <path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path>
      <path d="M3 21v-5h5"></path>
    </svg>
    Ziehen zum Drehen
  </div>
  <button class="sk-flipbtn" id="skFlipBtn">Karte umdrehen ⟳</button>
  <div class="sk-story" id="skStory"></div>
  <div class="sk-nav">
    <button class="sk-ic" id="skPrev2">‹ Zurück</button>
    <button class="sk-ic" id="skNext2">Weiter ›</button>
  </div>
</div>

<script id="skData" type="application/json" set:html={JSON.stringify(data)} is:inline></script>
<script is:inline define:vars={{ BASE }}>
  (function () {
    var D = JSON.parse(document.getElementById("skData").textContent);
    var CARDS = D.cards;
    var grid = document.getElementById("skGrid");
    function pad(n) { return String(n).padStart(2, "0"); }

    /* Titel und Sprueche kommen aus der eigenen Datei, trotzdem wird hier
       nicht mit innerHTML gearbeitet: ein kaufmaennisches Und oder eine
       spitze Klammer in einem spaeteren Kartentext wuerde das Markup sonst
       still zerlegen. */
    function txt(el, s) { el.textContent = s; return el; }
    function el(tag, cls) { var e = document.createElement(tag); if (cls) e.className = cls; return e; }

    CARDS.forEach(function (c, i) {
      var b = el("button", "sk-tile");
      b.setAttribute("aria-label", "Karte " + c.nr + ": " + c.title);
      var img = el("img");
      img.loading = "lazy";
      img.src = BASE + c.front;
      img.alt = c.title;
      img.width = 760;
      img.height = 1064;
      var num = el("span", "sk-num");
      num.appendChild(txt(el("b"), pad(c.nr)));
      num.appendChild(document.createTextNode("/21"));
      b.appendChild(img); b.appendChild(num);
      b.addEventListener("click", function () { open(i); });
      grid.appendChild(b);
    });

    var overlay = document.getElementById("skOverlay"),
        flip = document.getElementById("skFlip"),
        front = document.getElementById("skFront"),
        back = document.getElementById("skBack"),
        story = document.getElementById("skStory"),
        ser = document.getElementById("skSer");
    var cur = 0, angle = 0, dragging = false, startX = 0, startA = 0, moved = 0;
    var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    var rueck = el("img");
    rueck.src = BASE + D.back;
    rueck.alt = "Rückseite der Sammelkarte";
    back.appendChild(rueck);

    function render(i) {
      cur = i; angle = 0;
      flip.classList.add("drag");
      flip.style.transform = "rotateY(0deg)";
      requestAnimationFrame(function () { flip.classList.remove("drag"); });

      var c = CARDS[i];
      front.replaceChildren();
      var fi = el("img"); fi.src = BASE + c.front; fi.alt = c.title;
      front.appendChild(fi);
      ser.textContent = pad(c.nr) + " / 21";

      story.replaceChildren();
      story.appendChild(txt(el("div", "sk-stno"), pad(c.nr) + " / 21"));
      story.appendChild(txt(el("h2"), c.title));
      /* Deutsche Anfuehrungszeichen. Der Prototyp oeffnete mit „ und schloss
         mit einem geraden " — auf einer Seite mit eigener Typografie-Wache
         faellt so etwas auf. */
      story.appendChild(txt(el("div", "sk-spruch"), "„" + c.spruch + "“"));
      story.appendChild(txt(el("p", "sk-txt"), c.story));

      var id = el("div", "sk-idline");
      var brand = el("span", "brand");
      brand.appendChild(document.createTextNode("BIT"));
      brand.appendChild(txt(el("b"), "&"));
      brand.appendChild(document.createTextNode("BULLSHIT"));
      id.appendChild(brand);
      id.appendChild(txt(el("span"), c.id));
      story.appendChild(id);
    }

    function peek() {
      if (reduce) return;
      setTimeout(function () { if (!dragging) flip.style.transform = "rotateY(28deg)"; }, 260);
      setTimeout(function () { if (!dragging) flip.style.transform = "rotateY(0deg)"; }, 640);
    }
    function open(i) {
      render(i);
      overlay.classList.add("open");
      overlay.scrollTop = 0;
      document.body.style.overflow = "hidden";
      peek();
    }
    function close() {
      overlay.classList.remove("open");
      document.body.style.overflow = "";
    }
    function go(d) { render((cur + d + CARDS.length) % CARDS.length); overlay.scrollTop = 0; }

    document.getElementById("skClose").addEventListener("click", close);
    document.getElementById("skPrev").addEventListener("click", function () { go(-1); });
    document.getElementById("skPrev2").addEventListener("click", function () { go(-1); });
    document.getElementById("skNext2").addEventListener("click", function () { go(1); });
    overlay.addEventListener("click", function (e) { if (e.target === overlay) close(); });
    document.addEventListener("keydown", function (e) {
      if (!overlay.classList.contains("open")) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowRight") go(1);
      else if (e.key === "ArrowLeft") go(-1);
    });

    function snap() {
      var m = ((angle % 360) + 360) % 360;
      angle = (m > 90 && m < 270) ? 180 : 0;
      flip.style.transform = "rotateY(" + angle + "deg)";
    }
    document.getElementById("skFlipBtn").addEventListener("click", function () {
      flip.classList.remove("drag");
      var m = ((angle % 360) + 360) % 360;
      angle = (m > 90 && m < 270) ? 360 : 180;
      flip.style.transform = "rotateY(" + angle + "deg)";
      setTimeout(function () { angle = angle % 360; }, 560);
    });
    flip.addEventListener("pointerdown", function (e) {
      dragging = true; moved = 0; startX = e.clientX; startA = angle;
      flip.classList.add("drag"); flip.setPointerCapture(e.pointerId);
    });
    flip.addEventListener("pointermove", function (e) {
      if (!dragging) return;
      var dx = e.clientX - startX;
      moved = Math.max(moved, Math.abs(dx));
      angle = startA + dx * 0.55;
      flip.style.transform = "rotateY(" + angle + "deg)";
    });
    function endDrag() {
      if (!dragging) return;
      dragging = false;
      flip.classList.remove("drag");
      if (moved < 6) {
        var m = ((angle % 360) + 360) % 360;
        angle = (m > 90 && m < 270) ? 0 : 180;
        flip.style.transform = "rotateY(" + angle + "deg)";
      } else snap();
    }
    flip.addEventListener("pointerup", endDrag);
    flip.addEventListener("pointercancel", endDrag);

    /* Tiefenlink aus den QR-Codes: /sammelkarten#k05 oeffnet Karte 5. */
    var h = (location.hash || "").match(/^#k(\d{1,2})$/);
    if (h) {
      var n = parseInt(h[1], 10);
      if (n >= 1 && n <= CARDS.length) open(n - 1);
    }
  })();
</script>
