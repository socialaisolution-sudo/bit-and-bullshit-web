---
/**
 * „Sag mir Bescheid, wenn der Ratgeber fertig ist."
 *
 * Bewusst OHNE Newsletter-Dienst: Die Seite ist statisch, es gibt keinen
 * Server, der Adressen entgegennimmt. Statt ein Feld zu bauen, das so tut
 * als würde es speichern, öffnet das Formular eine vorbereitete E-Mail im
 * Mail-Programm. Die Adresse landet damit tatsächlich im Postfach — und es
 * werden nirgends personenbezogene Daten von uns gespeichert.
 *
 * Sobald ein Versand-Dienst feststeht, wird hier das action-Ziel getauscht;
 * Markup und Text können bleiben.
 */
interface Props {
  ratgeberTitel: string;
  empfaenger?: string;
}
const { ratgeberTitel, empfaenger = "hello@bitandbullshit.com" } = Astro.props;
const betreff = `Bescheid geben: ${ratgeberTitel}`;
---

<div class="benachrichtigung tape" data-empfaenger={empfaenger} data-betreff={betreff}>
  <p class="display benachrichtigung-kicker">// Bescheid geben</p>
  <p class="benachrichtigung-text">
    Der Ratgeber ist noch nicht fertig. Trag deine Adresse ein, dann sagen
    wir dir Bescheid, sobald der letzte Teil steht — und schicken dir das PDF.
  </p>

  <form class="benachrichtigung-form" id="benachrichtigung-form">
    <label class="sr-only" for="benachrichtigung-mail">Deine E-Mail-Adresse</label>
    <input
      type="email"
      id="benachrichtigung-mail"
      name="mail"
      required
      placeholder="deine@adresse.de"
      autocomplete="email"
    />
    <button type="submit" class="display">Bescheid geben</button>
  </form>

  <p class="benachrichtigung-hinweis">
    Öffnet dein Mail-Programm mit fertiger Nachricht. Kein Newsletter, keine
    Weitergabe — wir melden uns genau einmal, wenn der Ratgeber komplett ist.
    <noscript>
      Ohne JavaScript:
      <a href={`mailto:${empfaenger}?subject=${encodeURIComponent(betreff)}`}>
        schreib uns direkt
      </a>.
    </noscript>
  </p>
</div>

<script>
  const box = document.querySelector<HTMLElement>(".benachrichtigung");
  const form = document.getElementById("benachrichtigung-form") as HTMLFormElement | null;

  if (box && form) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const input = form.querySelector<HTMLInputElement>('input[name="mail"]');
      if (!input || !input.checkValidity()) {
        input?.reportValidity();
        return;
      }
      const empfaenger = box.dataset.empfaenger ?? "";
      const betreff = box.dataset.betreff ?? "";
      const body = `Bitte gebt mir Bescheid, sobald der Ratgeber fertig ist.\n\nMeine Adresse: ${input.value}\n`;
      window.location.href =
        `mailto:${empfaenger}?subject=${encodeURIComponent(betreff)}` +
        `&body=${encodeURIComponent(body)}`;
    });
  }
</script>

<style>
  .benachrichtigung {
    margin-top: 2.5rem;
    padding: 1.75rem 1.5rem 1.5rem;
    border: 1px solid rgb(from var(--color-paper) r g b / 0.12);
    border-radius: 0.4rem;
    background: rgb(from var(--color-paper) r g b / 0.03);
    transform: rotate(-0.5deg);
  }
  @media (min-width: 768px) {
    .benachrichtigung {
      padding: 2rem 2rem 1.75rem;
    }
  }

  .benachrichtigung-kicker {
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    color: var(--color-orange);
  }
  .benachrichtigung-text {
    margin-top: 0.85rem;
    max-width: 34rem;
    line-height: 1.65;
    color: rgb(from var(--color-paper) r g b / 0.8);
  }

  .benachrichtigung-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }
  .benachrichtigung-form input {
    flex: 1 1 14rem;
    min-width: 0;
    padding: 0.7rem 0.9rem;
    border-radius: 0.3rem;
    border: 1px solid rgb(from var(--color-paper) r g b / 0.18);
    background: rgb(from var(--color-ink) r g b / 0.6);
    color: var(--color-paper);
    font-family: inherit;
    font-size: 0.95rem;
  }
  .benachrichtigung-form input::placeholder {
    color: rgb(from var(--color-paper) r g b / 0.35);
  }
  .benachrichtigung-form input:focus {
    outline: none;
    border-color: var(--color-orange);
  }
  .benachrichtigung-form button {
    padding: 0.7rem 1.1rem;
    border: none;
    border-radius: 0.3rem;
    background: var(--color-orange);
    color: var(--color-ink);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .benachrichtigung-form button:hover {
    transform: translateY(-2px);
  }

  .benachrichtigung-hinweis {
    margin-top: 0.9rem;
    font-size: 0.78rem;
    line-height: 1.55;
    color: rgb(from var(--color-paper) r g b / 0.5);
  }
  .benachrichtigung-hinweis a {
    color: var(--color-orange);
    text-decoration: underline;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .benachrichtigung-form button:hover {
      transform: none;
    }
  }
</style>
