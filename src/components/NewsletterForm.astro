---
/**
 * Anmeldeblock für das Briefing.
 *
 * Eigenes Formular, kein Provider-Embed — auf der Seite wird kein
 * fremdes Skript geladen. Abgeschickt wird an eine Pages Function,
 * die Antwort ist eine Weiterleitung. Damit funktioniert die
 * Anmeldung auch ohne JavaScript.
 *
 * Drei Varianten, keine Sidebar: Der Traffic kommt überwiegend mobil
 * über TikTok, und eine rechte Spalte verschwindet dort unter dem
 * Text.
 *
 * `quelle` wird mitgespeichert, damit nach vier Wochen sichtbar ist,
 * welcher Platz trägt.
 */
import AmpelTeaser from "./AmpelTeaser.astro";

interface Props {
  variante?: "inline" | "artikel-ende" | "fusszeile";
  quelle: string;
}

const { variante = "artikel-ende", quelle } = Astro.props;

/* Name steht noch nicht fest — Platzhalter, bis Denny entschieden
   hat. Bewusst an einer Stelle, damit das Umbenennen später eine
   Zeile ist und keine Suche über alle Vorkommen. */
const NAME = "Das Briefing";

const TEXT = {
  inline: {
    kicker: "// Freitagmorgen",
    titel: `${NAME}`,
    zeile: "Was die Zahlen oben bedeuten, steht Freitagmorgen im Briefing.",
  },
  "artikel-ende": {
    kicker: "// Freitagmorgen",
    titel: `${NAME}`,
    zeile:
      "Einmal die Woche: wie der Markt gerade steht und was davon Bedeutung hat. " +
      "Keine Kursziele, keine Empfehlungen.",
  },
  fusszeile: {
    kicker: "// Briefing",
    titel: `${NAME}`,
    zeile: "Freitagmorgen, einmal die Woche.",
  },
}[variante];
---

<section class={`nl nl-${variante}`} data-quelle={quelle}>
  <p class="display nl-kicker">{TEXT.kicker}</p>
  <p class="display nl-titel">{TEXT.titel}</p>

  {/* Der Live-Wert ist der Teaser. Wir halten keine Information
      zurück, die woanders steht — wir halten die Arbeit zurück. */}
  {variante === "inline" && <AmpelTeaser />}

  <p class="nl-zeile">{TEXT.zeile}</p>

  <form class="nl-form" method="POST" action="/api/subscribe">
    <label class="sr-only" for={`nl-mail-${quelle}`}>Deine E-Mail-Adresse</label>
    <input
      type="email"
      id={`nl-mail-${quelle}`}
      name="mail"
      required
      placeholder="deine@adresse.de"
      autocomplete="email"
      spellcheck="false"
    />

    {/* Honigtopf. Kein Mensch sieht das Feld, kein Mensch füllt es
        aus. Nicht mit display:none versteckt — manche Bots prüfen
        darauf. */}
    <div class="nl-honig" aria-hidden="true">
      <label for={`nl-web-${quelle}`}>Website (bitte frei lassen)</label>
      <input type="text" id={`nl-web-${quelle}`} name="website" tabindex="-1" autocomplete="off" />
    </div>

    <input type="hidden" name="quelle" value={quelle} />
    {/* Wird beim Laden gesetzt. Ohne JavaScript bleibt es leer, und
        die Function lässt die Anmeldung dann trotzdem durch — sonst
        könnte sich niemand ohne Skript anmelden. */}
    <input type="hidden" name="gestartet" value="" data-gestartet />

    <button type="submit" class="display">Eintragen</button>
  </form>

  {/* Die Einwilligungszeile. Kein Kästchen zum Anhaken: Bei einem
      Formular, das ausschließlich der Anmeldung dient, ist das
      Absenden selbst die Handlung — ein zusätzliches Häkchen wäre
      eine Hürde ohne Gewinn. Was zählt, ist dass hier steht, worin
      eingewilligt wird, bevor jemand klickt. */}
  <p class="nl-klein">
    Mit dem Absenden willigst du ein, dass wir dir das Briefing per E-Mail
    schicken. Wir bestätigen die Anmeldung vorher per Mail; ohne deinen Klick
    darin tragen wir dich nicht ein. Versand über Brevo, Server in der EU.
    Widerruf jederzeit über den Link in jeder Ausgabe.
    <a href="/datenschutz/">Datenschutz</a> ·
    <a href="/newsletter/">Was drinsteht</a>
  </p>
</section>

<script>
  /* Zeitstempel für die Bot-Erkennung. Wer schneller absendet, als
     ein Mensch tippen kann, wird stillschweigend verworfen. */
  for (const feld of document.querySelectorAll<HTMLInputElement>("[data-gestartet]")) {
    feld.value = String(Date.now());
  }
</script>

<style>
  .nl {
    border: 2px solid var(--color-paper, #f4f1ea);
    background: rgba(255, 255, 255, 0.04);
    padding: 1.5rem;
    margin: 2.5rem 0;
  }
  .nl-kicker {
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    color: var(--color-orange, #f7931a);
    margin: 0;
  }
  .nl-titel {
    font-size: 1.5rem;
    line-height: 1.1;
    margin: 0.4rem 0 0;
  }
  .nl-zeile {
    margin: 0.75rem 0 0;
    font-size: 0.98rem;
    opacity: 0.85;
  }

  .nl-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.1rem 0 0;
  }
  .nl-form input[type="email"] {
    flex: 1 1 14rem;
    min-width: 0;
    padding: 0.7rem 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(0, 0, 0, 0.25);
    color: inherit;
    font: inherit;
  }
  .nl-form input[type="email"]:focus-visible {
    outline: 2px solid var(--color-orange, #f7931a);
    outline-offset: 2px;
  }
  .nl-form button {
    padding: 0.7rem 1.4rem;
    border: none;
    background: var(--color-orange, #f7931a);
    color: #111;
    cursor: pointer;
    font-size: 0.9rem;
    letter-spacing: 0.06em;
  }
  .nl-form button:hover { filter: brightness(1.1); }

  /* Aus dem Blickfeld, aber nicht display:none — manche Bots prüfen
     genau darauf und überspringen versteckte Felder. */
  .nl-honig {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .nl-klein {
    margin: 0.85rem 0 0;
    font-size: 0.78rem;
    opacity: 0.6;
  }

  .nl-fusszeile { padding: 1.1rem; margin: 0; }
  .nl-fusszeile .nl-titel { font-size: 1.15rem; }
  .nl-fusszeile .nl-klein { font-size: 0.72rem; }
</style>

<script>
  /* Den Inline-Block an die Marke im Fließtext hängen. Die Marke
     setzt rehype-anmeldeplatz beim Bauen nach rund 40 % der Absätze.
     Findet sich keine, bleibt der Block, wo er ist. */
  const block = document.querySelector<HTMLElement>("[data-anmeldeblock]");
  const platz = document.querySelector<HTMLElement>("[data-anmeldeplatz]");
  if (block && platz) {
    platz.replaceWith(block);
    block.hidden = false;
  } else if (block) {
    block.hidden = false;
  }
</script>
