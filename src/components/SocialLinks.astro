---
interface Props {
  size?: "sm" | "md" | "lg";
}
const { size = "md" } = Astro.props;

const sizes = {
  sm: "px-3 py-1.5 text-xs",
  md: "px-4 py-2 text-sm",
  lg: "px-5 py-3 text-base",
};

const cls = sizes[size];
---

<div class="flex flex-wrap items-center gap-3">
  <a
    href="https://www.tiktok.com/@bitandbullshit"
    target="_blank"
    rel="noopener"
    class:list={[
      "inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 uppercase tracking-widest text-paper transition hover:border-orange hover:text-orange",
      cls,
    ]}
  >
    <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43V8.85a8.16 8.16 0 0 0 4.77 1.52V6.93a4.85 4.85 0 0 1-1.84-.24Z" />
    </svg>
    TikTok
  </a>
  <a
    href="https://www.instagram.com/bitandbullshit"
    target="_blank"
    rel="noopener"
    class:list={[
      "inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 uppercase tracking-widest text-paper transition hover:border-orange hover:text-orange",
      cls,
    ]}
  >
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
    </svg>
    Instagram
  </a>
</div>
